{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "mounts": [
    {
      "source": "claude-dev-container-${devcontainerId}",
      "target": "/home/vscode/.claude",
      "type": "volume"
    }
  ],
  "forwardPorts": [4321],

  // Optional: Auto-open browser or set custom labels
  "portsAttributes": {
    "4321": {
      "label": "Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "runArgs": [
  "--env-file", "${localWorkspaceFolder}/.devcontainer/.env.local",
  // Maakt de host-machine bereikbaar als host.docker.internal vanuit de
  // container -- nodig om LM Studio (LLM-extractie/tagging, draait op de
  // host, niet in de container) te bereiken, bv. via
  // `--base-url http://host.docker.internal:1234/v1`.
  "--add-host", "host.docker.internal:host-gateway"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "gpg --import .devcontainer/gpg-pubkey.asc && git config --global commit.gpgsign true && uv sync && cd frontend && npx playwright install --with-deps chromium",
  "postStartCommand": "sudo chown -R vscode:vscode ~/.claude"
}