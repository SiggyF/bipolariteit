{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "mounts": [
    {
      "source": "claude-dev-container-${devcontainerId}",
      "target": "/home/vscode/.claude",
      "type": "volume"
    },
    {
      "source": "gemini-antigravity-dev-container-${devcontainerId}",
      "target": "/home/vscode/.gemini",
      "type": "volume"
    }
  ],
  "forwardPorts": [4321, 8787],

  // Optional: Auto-open browser or set custom labels
  "portsAttributes": {
    "4321": {
      "label": "Frontend",
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "Dask-dashboard",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "runArgs": [
  "--env-file", "${localWorkspaceFolder}/.devcontainer/.env.local",
  // Maakt de host-machine bereikbaar als host.docker.internal vanuit de
  // container -- nodig om LM Studio (LLM-extractie/tagging, draait op de
  // host, niet in de container) te bereiken, bv. via
  // `--base-url http://host.docker.internal:1234/v1`.
  "--add-host", "host.docker.internal:host-gateway"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // Playwright MCP-server op de host starten (buiten deze container): Chrome
  // kan niet in de eigen sandbox van deze devcontainer starten (het
  // zygote-proces crasht, PID/network-namespace niet toegestaan).
  // initializeCommand draait op de host zelf, vóór de container start -- de
  // enige hook die een host-Docker-container kan aanmaken/hernemen.
  // Idempotent: bestaat de container al (nog actief van een vorige run),
  // dan alleen starten; anders aanmaken. --rm i.p.v. een restart-policy: de
  // container verdwijnt vanzelf zodra hij stopt, initializeCommand maakt 'm
  // gewoon opnieuw aan bij de volgende devcontainer-start. --allowed-hosts
  // '*' is nodig omdat de server anders de host.docker.internal-Host-header
  // van deze devcontainer met 403 afwijst.
  "initializeCommand": "docker start playwright-mcp 2>/dev/null || docker run -d --rm --name playwright-mcp -p 8931:8931 --init mcr.microsoft.com/playwright/mcp --port 8931 --host 0.0.0.0 --allowed-hosts '*'",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "google.google-antigravity",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "antigravity.workspaceMode": "container",
        "antigravity.allowedTools": ["bash", "fileEdit", "webSearch", "terminal", "read", "write"],
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
          "source.fixAll": "never",
          "source.fixAll.eslint": "never"
        },
        "[vue]": {
          "editor.formatOnSave": false
        },
        "[astro]": {
          "editor.formatOnSave": false
        },
        "[typescript]": {
          "editor.formatOnSave": false
        },
        "[javascript]": {
          "editor.formatOnSave": false
        }
      }      
    }
  },
  // gpg-pubkey.asc staat in .gitignore (elke gebruiker levert zijn eigen
  // publieke sleutel aan) -- het bestand ontbreekt dus op een verse clone.
  // Als het er niet is: alleen waarschuwen en commit.gpgsign uitlaten, in
  // plaats van de hele keten (incl. uv sync/playwright install) te laten
  // stuklopen op een missend bestand (zie issue #255).
  "postCreateCommand": "if [ -f .devcontainer/gpg-pubkey.asc ]; then gpg --import .devcontainer/gpg-pubkey.asc && git config --global commit.gpgsign true; else echo 'WAARSCHUWING: .devcontainer/gpg-pubkey.asc ontbreekt -- commit.gpgsign blijft uit (zie issue #255)'; fi; uv sync --all-groups && cd frontend && npx playwright install --with-deps chromium",
  // Persistente dask-scheduler+worker op een vast adres/dashboardpoort, met
  // dask's eigen built-in CLI (`dask scheduler`/`dask worker`, zie `dask
  // --help` -- geen zelfgebouwde wrapper eromheen), zodat
  // pipeline.tiling.build_pyramid 'm hergebruikt i.p.v. bij elke run een
  // eigen, na afloop meteen weer verdwenen cluster op te zetten (issue
  // #215-discussie: dashboard moet echt te bekijken zijn).
  //
  // `setsid ... </dev/null` (niet alleen `nohup ... &`): live bevestigd dat
  // zonder setsid beide processen wél starten (logbestand wordt aangemaakt)
  // maar binnen enkele seconden weer verdwijnen, met een 0-byte logbestand
  // -- nohup voorkomt alleen SIGHUP, niet dat de devcontainer-tooling de
  // hele procesgroep van postStartCommand opruimt zodra dat commando
  // terugkeert (en `(cmd &)` keert vrijwel synchroon terug). setsid start
  // een nieuwe sessie, losgekoppeld van die procesgroep, en overleeft die
  // opruiming; stdin expliciet sluiten voorkomt dat het proces alsnog aan
  // een sessie hangt die straks wegvalt.
  //
  // --nthreads 10 (i.p.v. de default = aantal cores, hier 8): de LLM-extractie/
  // tagging-batches (pipeline/extract_arguments.py, pipeline/tag_arguments.py
  // --parallel) zijn netwerk-IO-bound, niet CPU-bound (de thread-cpu-tijd per
  // taak is verwaarloosbaar t.o.v. de wachttijd op de HTTP-response) -- meer
  // gelijktijdige threads dan cores is dus prima en verhoogt de doorvoer. 12
  // bleek te veel: de Hugging Face-router rate-limitte toen met HTTP 429
  // (105 van de 1000 requests in een batch), bij 10 gebeurde dat niet.
  "postStartCommand": "sudo chown -R vscode:vscode ~/.claude ~/.gemini && setsid nohup uv run --group tiling dask scheduler --host 127.0.0.1 --port 8786 --dashboard-address :8787 > /tmp/dask-scheduler.log 2>&1 < /dev/null & setsid nohup uv run --group tiling dask worker tcp://127.0.0.1:8786 --nthreads 10 > /tmp/dask-worker.log 2>&1 < /dev/null &"
}