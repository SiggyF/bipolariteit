---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClaimsHighlights from "../components/ClaimsHighlights.vue";
import DebateVideoView from "../components/DebateVideoView.vue";
import HomeVideoPreview from "../components/HomeVideoPreview.vue";
import { debateId } from "../lib/debateId";
import { debateName } from "../lib/debateName";
import { debateThumbnailUrl } from "../lib/debateThumbnail";
import { resolveDataBaseUrl } from "../lib/dataBaseUrl";
import { findLatestDebate } from "../lib/latestDebate";
import { formatDate } from "../lib/formatDate";
import { groupByDebate } from "../lib/groupByDebate";

const dataBaseUrl = resolveDataBaseUrl();

const topicModules = import.meta.glob("../../../data/export/topics/*.json", { eager: true });

const latestDebate = findLatestDebate(
	Object.values(topicModules as any).map((mod: any) => ({ slug: mod.default.slug, arguments: mod.default.arguments })),
);
const latestDebateName = latestDebate ? debateName(latestDebate.arguments[0]?.document.video_url ?? null) : null;
const latestDebateDate = latestDebate ? formatDate(latestDebate.earliestPublishedAt) : null;
const latestDebateTopicName = latestDebate
	? (Object.values(topicModules as any).find((mod: any) => mod.default.slug === latestDebate.topicSlug) as any)?.default.name
	: null;
// Klein en server-side (zelfde aanpak als highlightedThumbnails hieronder):
// DebateVideoView/ClaimsHighlights krijgen voortaan alleen debateId/topicSlug
// en fetchen de argumentenlijst zelf client-side (issue #119) -- maar de
// video-URL/poster moeten al vóór die fetch bekend zijn, anders wacht de
// video zelf ook op de JSON.
const latestDebateRawVideoUrl = latestDebate ? latestDebate.arguments[0]?.document.raw_video_url ?? null : null;
const latestDebatePosterUrl = latestDebate
	? (() => {
			for (const argument of latestDebate.arguments) {
				const url = debateThumbnailUrl(argument.document.video_url, argument.document.published_at, argument.start_seconds);
				if (url) return url;
			}
			return null;
		})()
	: null;

// Redactionele keuze (geen automatische selectie): vier debatten met veel
// argumenten, verspreid over topics, video bevestigd werkend (zie issue
// #152 / pipeline/check_video_urls.py). Vier i.p.v. drie omdat dat op
// .card-grid's auto-fill-kolommen (main.css) evenwichtiger uitlijnt (2x2
// i.p.v. een half-lege laatste rij).
const HIGHLIGHTED_DEBATE_IDS = ["1223sv0", "n6wbek", "oo1q3d", "1r1bopd"];

const topicNameBySlug = new Map(
	Object.values(topicModules as any).map((mod: any) => [mod.default.slug, mod.default.name]),
);
const allDebates = groupByDebate(
	Object.values(topicModules as any).map((mod: any) => ({ slug: mod.default.slug, arguments: mod.default.arguments })),
);
const debatesById = new Map(allDebates.map((debate) => [debate.id, debate]));
const highlightedDebates = HIGHLIGHTED_DEBATE_IDS.map((id) => debatesById.get(id)).filter(
	(debate): debate is NonNullable<typeof debate> => debate != null,
);

// Zelfde "eerste argument met een gematchte videospanne"-aanpak als Python's
// _topic_image_url (pipeline/build_static_data.py), maar hier per debat i.p.v.
// per topic -- vandaar een losse scan i.p.v. iets uit groupByDebate() te
// hergebruiken, die alleen aantallen bijhoudt en geen argument-referentie.
const highlightedThumbnails = new Map<string, string>();
for (const mod of Object.values(topicModules as any) as any[]) {
	for (const argument of mod.default.arguments) {
		const rawVideoUrl = argument.document.raw_video_url;
		if (!rawVideoUrl) continue;
		const id = debateId(rawVideoUrl);
		if (!HIGHLIGHTED_DEBATE_IDS.includes(id) || highlightedThumbnails.has(id)) continue;
		const url = debateThumbnailUrl(argument.document.video_url, argument.document.published_at, argument.start_seconds);
		if (url) highlightedThumbnails.set(id, url);
	}
}
---

<BaseLayout title="Bipolariteit">
			<div class="home">
				{latestDebate && (
					<section class="latest-debate">
						<h2 class="latest-debate-heading" title={latestDebateName ?? undefined}>Laatste geanalyseerde debat ({latestDebateDate})</h2>
						<DebateVideoView
							debateId={latestDebate.id}
							topicSlug={latestDebate.topicSlug}
							dataBaseUrl={dataBaseUrl}
							rawVideoUrl={latestDebateRawVideoUrl}
							posterUrl={latestDebatePosterUrl}
							debateHref={`/debatten/${latestDebate.id}/`}
							defaultExpanded={false}
							initialMuted={true}
							client:only="vue"
						/>
						<p class="latest-debate-link">
							<a href={`/onderwerpen/${latestDebate.topicSlug}/`}>
								Bekijk alle argumenten over {latestDebateTopicName ?? latestDebate.topicSlug} &rarr;
							</a>
						</p>
						<ClaimsHighlights
							debateId={latestDebate.id}
							dataBaseUrl={dataBaseUrl}
							topicHref={`/onderwerpen/${latestDebate.topicSlug}/`}
							heading="Argumenten uit dit debat"
							client:only="vue"
						/>
					</section>
				)}
				<div class="home-intro">
					<h1>Bipolariteit</h1>
					<p class="intro">
						Wie zegt wat. Kamerleden geprofileerd op argumenten en stijl in gepolariseerde debatten. Terug te
						zien in de video van de bijdrage, steeds bijgewerkt.
					</p>
					<p class="motto">"We listen and we don't judge."</p>
				</div>
				<section class="video-preview-section">
					<h2>Uitgelichte argumenten</h2>
					<HomeVideoPreview dataBaseUrl={dataBaseUrl} client:only="vue" />
				</section>
				{highlightedDebates.length > 0 && (
					<section class="highlighted-debates">
						<h2>Uitgelichte debatten</h2>
						<ul class="card-grid">
							{highlightedDebates.map((debate) => (
								<li>
									<a href={`/debatten/${debate.id}/`} class="card-tile">
										{highlightedThumbnails.has(debate.id) && (
											<span class="card-tile-image">
												<img src={highlightedThumbnails.get(debate.id)} alt="" loading="lazy" />
											</span>
										)}
										<span class="card-tile-name">{debate.name ?? "Debat"}</span>
										<span class="card-tile-subtitle">{topicNameBySlug.get(debate.topicSlug) ?? debate.topicSlug}</span>
										<span class="card-tile-count">{formatDate(debate.earliestPublishedAt)} · {debate.argumentCount} argumenten</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
</BaseLayout>

<style>
	/* Mobiel-eerst: video staat in de DOM vóór de titel/intro (het eerste wat
	   je ziet op een telefoon). Op desktop (>900px, dezelfde breakpoint als de
	   tabbalk elders in de site) moet de titel weer bovenaan staan -- vandaar
	   de grid-reorder i.p.v. de DOM-volgorde te laten bepalen. */
	.home {
		display: grid;
		gap: var(--space-3);
	}

	@media (min-width: 901px) {
		.home {
			grid-template-areas: "intro" "video" "preview" "highlighted";
		}

		.home-intro {
			grid-area: intro;
		}

		.latest-debate {
			grid-area: video;
		}

		.video-preview-section {
			grid-area: preview;
		}

		.highlighted-debates {
			grid-area: highlighted;
		}
	}

	.latest-debate {
		max-width: min(720px, 100%);
		/* Geen eigen margin: .home's gap (hierboven) is al de ruimte tussen
		   dit blok en .home-intro, aan weerszijden (mobiel: video eerst,
		   desktop: intro eerst, zie de media query hierboven) -- een eigen
		   margin hier stapelde daar nog eens bovenop, plus (via de
		   heading) de user-agent-default margin-block-start van <h2>. Drie
		   marges op dezelfde plek voor hetzelfde doel. main's eigen
		   padding (main.css) is de enige bron voor de ruimte aan de
		   paginaranden. */
		margin: 0;
		/* Zelfde reden als min-width: 0 op .player-column in
		   DebateVideoView.vue: dit is een grid-item, dat anders zijn
		   inhoud (uiteindelijk de niet-wrappende .controls-row-knoppen)
		   de hele pagina breder dan de viewport kan laten duwen. */
		min-width: 0;
	}

	.latest-debate-heading {
		margin: 0 0 var(--space-2);
	}

	.latest-debate-link {
		margin-top: var(--space-2);
	}

	/* Bredere kolommen dan .card-grid's 140px-default (main.css): een
	   debattitel ("Samenhangende aanpak landbouw natuur en stikstof") is een
	   stuk langer dan een partij- of onderwerpnaam en verdrinkt anders in
	   drie/vier regels op een te smalle tegel. */
	.highlighted-debates .card-grid {
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}
</style>
