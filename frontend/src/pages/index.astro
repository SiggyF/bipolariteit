---
import BaseLayout from "../layouts/BaseLayout.astro";
import DebateVideoView from "../components/DebateVideoView.vue";
import { debateName } from "../lib/debateName";
import { findLatestDebate } from "../lib/latestDebate";
import { formatDate } from "../lib/formatDate";

const topicModules = import.meta.glob("../../../data/export/topics/*.json", { eager: true });

const latestDebate = findLatestDebate(
	Object.values(topicModules as any).map((mod: any) => ({ slug: mod.default.slug, arguments: mod.default.arguments })),
);
const latestDebateName = latestDebate ? debateName(latestDebate.arguments[0]?.document.video_url ?? null) : null;
const latestDebateDate = latestDebate ? formatDate(latestDebate.earliestPublishedAt) : null;
const latestDebateTopicName = latestDebate
	? (Object.values(topicModules as any).find((mod: any) => mod.default.slug === latestDebate.topicSlug) as any)?.default.name
	: null;
---

<BaseLayout title="Bipolariteit">
			<h1>Bipolariteit</h1>
			<p class="intro">
				Wie zegt wat. Kamerleden geprofileerd op argumenten en stijl in gepolariseerde debatten. Terug te
				zien in de video van de bijdrage, steeds bijgewerkt.
			</p>
			<p class="motto">"We listen and we don't judge."</p>

			{latestDebate && (
				<section class="latest-debate">
					<h2 class="latest-debate-heading" title={latestDebateName ?? undefined}>Laatste geanalyseerde debat ({latestDebateDate})</h2>
					<DebateVideoView
						arguments={latestDebate.arguments}
						topicSlug={latestDebate.topicSlug}
						debateHref={`/debatten/${latestDebate.id}/`}
						defaultExpanded={false}
						initialMuted={true}
						client:only="vue"
					/>
					<p class="latest-debate-link">
						<a href={`/onderwerpen/${latestDebate.topicSlug}/`}>
							Bekijk alle argumenten over {latestDebateTopicName ?? latestDebate.topicSlug} &rarr;
						</a>
					</p>
				</section>
			)}
</BaseLayout>

<style>
	.latest-debate {
		max-width: 520px;
		margin: var(--space-3) 0 var(--space-4);
	}

	.latest-debate-heading {
		margin-bottom: var(--space-2);
	}

	.latest-debate-link {
		margin-top: var(--space-2);
	}
</style>
