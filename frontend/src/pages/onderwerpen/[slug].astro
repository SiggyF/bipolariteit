---
import TopicView from "../../components/TopicView.vue";
import ArgumentTree from "../../components/ArgumentTree.vue";
import FeedbackExport from "../../components/FeedbackExport.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseTopicDescription } from "../../lib/parseTopicDescription";
import { resolveDataBaseUrl } from "../../lib/dataBaseUrl";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

// Losse map (niet data/export/topics/ zelf): de argumentenboom is een
// experimentele, aparte export (pipeline/build_argument_tree.py) en bestaat
// niet per se voor elk topic.
const treeModules = import.meta.glob("../../../../data/export/argument-trees/*.json", { eager: true });

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });
	return Object.values(modules).map((mod: any) => ({
		params: { slug: mod.default.slug },
	}));
}

const { slug } = Astro.params;
const mod: any = Object.values(topicModules).find((m: any) => m.default.slug === slug);
const topic = mod.default;
const treeMod: any = Object.values(treeModules).find((m: any) => m.default.slug === slug);
const argumentTree = treeMod ? treeMod.default : null;
const description = topic.description ? parseTopicDescription(topic.description) : null;
// De argumentenlijst zelf gaat niet meer als Astro-prop mee (~7-11 MB per
// onderwerp, tegen de Cloudflare Workers-assetlimiet van 25 MiB aan voor de
// grotere onderwerpen -- issue #163); TopicView.vue fetcht 'm client-side
// vanaf scripts/export_public_data.ts's output.
const dataBaseUrl = resolveDataBaseUrl();
---

<BaseLayout title={`${topic.name} - Bipolariteit`} description={topic.description}>
			<a href="/onderwerpen/" class="back-link">&larr; alle onderwerpen</a>
			<div class="topic-header">
				<h1>{topic.name}</h1>
				{description && (
					<div class="topic-description">
						{description.intro.map((paragraph) => <p>{paragraph}</p>)}
						{description.pro && description.contra && (
							<dl class="topic-pro-contra">
								<div class="topic-pro-contra-item is-pro">
									<dt>Pro</dt>
									<dd>{description.pro}</dd>
								</div>
								<div class="topic-pro-contra-item is-contra">
									<dt>Contra</dt>
									<dd>{description.contra}</dd>
								</div>
							</dl>
						)}
						{description.note && <p class="topic-description-note">{description.note}</p>}
					</div>
				)}
			</div>

			{argumentTree && (
				<section class="argument-tree-section">
					<h2>Argumentenboom</h2>
					<p class="argument-tree-note">
						Experimenteel: elk knooppunt is een letterlijk argument. Klik op een node om te vouwen/ontvouwen; klik op
						een argument-node voor het volledige citaat en eventuele weerleggingen.
					</p>
					<ArgumentTree tree={argumentTree} client:only="vue" />
				</section>
			)}

			{/* Eén island voor alles wat op het filter reageert: de grafieken en de
			    kolommen delen zo dezelfde argumentenlijst en filterstore. Ook
			    scheelt het serialiseren -- het corpus is enkele MB's groot en zou
			    anders per island in de HTML terechtkomen. client:only omdat de
			    filterstore de URL leest, wat op de server niet bestaat. */}
			<TopicView
				topicSlug={topic.slug}
				dataBaseUrl={dataBaseUrl}
				client:only="vue"
			/>

			<FeedbackExport client:load />
</BaseLayout>
