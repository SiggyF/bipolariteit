---
import topicsIndex from "../../../../data/export/topics-index.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TiledPlenairMap from "../../components/TiledPlenairMap.vue";
import { TEGENSTELLING } from "../../lib/topics";
import { resolveTilesBaseUrl } from "../../lib/dataBaseUrl";

// De plenaire-kaart data (~6 MB) gaat niet meer als Astro-prop mee -- die
// duwde deze indexpagina op ~9 MB. TiledPlenairMap.vue fetcht 'm client-side
// vanaf scripts/export_public_data.ts's output (issue #163).
//
// Vervangt hier de oude PlenairMap.vue (canvas/ECharts) door de tiled
// MapLibre+deck.gl-variant (issue #259) -- PlenairMap.vue zelf blijft
// bestaan als losstaand component, alleen niet langer op deze pagina
// ingezet.
const tilesBaseUrl = resolveTilesBaseUrl();
---

<BaseLayout title="Onderwerpen - Bipolariteit">
	<h1>Onderwerpen</h1>
	<ul class="card-grid">
		{topicsIndex.map((topic) => (
			<li>
				<a href={`/onderwerpen/${topic.slug}/`} class="card-tile">
					{topic.image_url && (
						<span class="card-tile-image">
							<img src={topic.image_url} alt="" loading="lazy" />
						</span>
					)}
					<span class="card-tile-name">{topic.name}</span>
					{TEGENSTELLING[topic.slug] && <span class="card-tile-subtitle">{TEGENSTELLING[topic.slug]}</span>}
					<span class="card-tile-count">{topic.argument_count} argumenten</span>
				</a>
			</li>
		))}
	</ul>

	<p class="topics-debatten-link">
		<a href="/debatten/">Alle geanalyseerde debatten &rarr;</a>
	</p>

	<TiledPlenairMap
		tilesBaseUrl={tilesBaseUrl}
		client:only="vue"
	/>
</BaseLayout>

<style>
	.topics-debatten-link {
		margin-top: var(--space-4);
	}
</style>
