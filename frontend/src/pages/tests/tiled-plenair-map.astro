---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TiledPlenairMap from "../../components/TiledPlenairMap.vue";
import { resolveDataBaseUrl, resolveTilesBaseUrl } from "../../lib/dataBaseUrl";

const tilesBaseUrl = resolveTilesBaseUrl();
const dataBaseUrl = resolveDataBaseUrl();
---

<BaseLayout title="Tiled Plenaire Kaart (experimenteel) - Bipolariteit">
	<p>
		Experimenteel alternatief renderpad voor de plenaire kaart (issue #215/#253): leest een
		vector-tile-pyramide (.pmtiles) op de volle dataset i.p.v. de platte plenair-map.json. Zie <code
			>PlenairMap.vue</code
		>
		voor de bestaande, ongewijzigde kaart.
	</p>
	<TiledPlenairMap tilesBaseUrl={tilesBaseUrl} dataBaseUrl={dataBaseUrl} client:only="vue" />
</BaseLayout>
