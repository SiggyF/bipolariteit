---
import BaseLayout from "../layouts/BaseLayout.astro";
import topicsIndex from "../../../data/export/topics-index.json";
import { deriveTagUsage, type TagUsageRow } from "../lib/aggregate";
import { analyseTable, canonicalSigns } from "../lib/correspondence";
import { ICOON_PAD, PERSPECTIEVEN } from "../lib/tagIcons.generated";
import { tagIconPath, perspectiefWeergaveNaam } from "../lib/tagIcon";
import { STANCES, stanceLabel, stanceDescription, TYPOLOGIES, typologyLabel, typologyDescription, type Argument } from "../lib/types";
import { TYPOLOGY_COLORS } from "../lib/typologyColors";

// Opsomming in de intro-alinea ("Voor stikstof, abortus, ... ") -- afgeleid
// van de topic-slugs i.p.v. hardcoded, zodat een nieuw onderwerp hier
// vanzelf verschijnt. slug i.p.v. name: name is inconsistent qua hoofdletter
// ("stikstof" vs "Abortus") en bij asiel langer ("Asiel en migratie") dan in
// deze opsomming past.
const topicSlugList = topicsIndex.map((t) => t.slug);
const topicSlugListText =
	topicSlugList.length <= 1
		? (topicSlugList.join("") ?? "")
		: `${topicSlugList.slice(0, -1).join(", ")} en ${topicSlugList.at(-1)}`;

// Alle argumenten over alle onderwerpen heen, alleen om het taxonomie-
// overzicht hieronder te vullen -- zelfde bron en aggregatiefunctie als de
// tag-grafieken elders op de site (deriveTagUsage telt alleen LLM-toegekende
// tags, zie aggregate.ts).
const topicModules = import.meta.glob("../../../data/export/topics/*.json", { eager: true }) as Record<
	string,
	{ default: { arguments: Argument[] } }
>;
const allArguments = Object.values(topicModules).flatMap((mod) => mod.default.arguments);
const tagUsage = new Map(deriveTagUsage(allArguments).map((row) => [row.sleutel, row]));

// Aantal argumenten per standpunt/typologie, voor de tellers in de legenda
// hieronder -- zelfde bron (allArguments) als de tag-taxonomie erboven.
const stanceCounts = new Map<string, number>();
const typologyCounts = new Map<string, number>();
for (const argument of allArguments) {
	stanceCounts.set(argument.stance, (stanceCounts.get(argument.stance) ?? 0) + 1);
	typologyCounts.set(argument.typology, (typologyCounts.get(argument.typology) ?? 0) + 1);
}

// Labelgroep-volgorde per perspectief herleiden uit de taxonomie-volgorde in
// tagIcons.generated.ts (zelf gegenereerd uit data/tags.toml) i.p.v. die
// groepering nog een keer los te dupliceren -- de frontend leest tags.toml
// bewust niet rechtstreeks (zie lib/types.ts). Tags zonder toekenning in de
// huidige data blijven buiten beeld: dit overzicht toont de taxonomie zoals
// ze daadwerkelijk gebruikt wordt, niet als lege belofte.
const taxonomie = PERSPECTIEVEN.map((perspectief) => {
	const labelgroepOrder: string[] = [];
	const labelgroepTags = new Map<string, TagUsageRow[]>();
	for (const sleutel of Object.keys(perspectief.tags)) {
		const row = tagUsage.get(sleutel);
		if (!row) continue;
		if (!labelgroepTags.has(row.labelgroep)) {
			labelgroepTags.set(row.labelgroep, []);
			labelgroepOrder.push(row.labelgroep);
		}
		labelgroepTags.get(row.labelgroep)!.push(row);
	}
	return {
		naam: perspectief.naam,
		kleur: perspectief.kleur,
		icoon: perspectief.icoon,
		labelgroepen: labelgroepOrder.map((naam) => ({ naam, tags: labelgroepTags.get(naam)! })),
	};
}).filter((p) => p.labelgroepen.length > 0);

// Mini-CA-voorbeeld bij de uitleg hieronder: een echte 3x3-uitsnede uit de
// huidige data (zie de aantallen in de tabel), met dezelfde wiskunde als de
// kaart zelf (lib/correspondence.ts) i.p.v. een los plaatje -- verandert de
// data, dan verschuift dit voorbeeld gewoon mee bij de volgende build.
const caExampleRows = ["BBB", "D66", "SGP"];
const caExampleTags = ["Ideologie-GAL", "Ideologie-TAN", "Moraliteit-Autoriteit"];
const caExampleCounts = [
	[7, 146, 87],
	[166, 0, 42],
	[1, 85, 19],
];
const caExampleKleur =
	PERSPECTIEVEN.find((p) => caExampleTags.every((t) => t in p.tags))?.kleur ?? "#B15E4A";

const caExampleResult = analyseTable(caExampleCounts, 2)!;
const caExample = canonicalSigns({
	inertiaPct: caExampleResult.inertiaPct,
	nComponents: caExampleResult.nComponents,
	unit: "partij",
	rows: caExampleRows.map((label, i) => ({
		label,
		coords: caExampleResult.F[i],
		n: caExampleCounts[i].reduce((a, b) => a + b, 0),
	})),
	tags: caExampleTags.map((sleutel, j) => ({
		sleutel,
		beschrijving: "",
		labelgroep: "",
		perspectief: "",
		coords: caExampleResult.G[j],
		n: 0,
	})),
});

// Vaste, gelijke schaal op beide assen (geen aparte x/y-stretch) -- dat toont
// eerlijk dat dim. 2 hier nauwelijks meetelt (3,4% inertie), i.p.v. de tweede
// as kunstmatig op te blazen tot iets wat evenveel gewicht lijkt te hebben.
const CA_SCALE = 130;
const CA_CX = 180;
const CA_CY = 150;
function caPoint(coords: number[]) {
	return { x: CA_CX + coords[0] * CA_SCALE, y: CA_CY - coords[1] * CA_SCALE };
}

// Handmatige labelposities: bij deze specifieke tabel liggen Ideologie-TAN
// vlak bij SGP en Moraliteit-Autoriteit vlak bij BBB (zie de toelichting
// erboven), dus een vaste "boven het punt"/"onder het punt"-regel voor alle
// labels zou twee paren over elkaar heen leggen.
type CaLabelOffset = { dx: number; dy: number; anchor: "start" | "middle" | "end" };
const CA_TAG_LABEL_OFFSET: Record<string, CaLabelOffset> = {
	"Ideologie-GAL": { dx: 0, dy: -11, anchor: "middle" },
	"Ideologie-TAN": { dx: 0, dy: 18, anchor: "middle" },
	"Moraliteit-Autoriteit": { dx: 9, dy: 18, anchor: "start" },
};
const CA_ROW_LABEL_OFFSET: Record<string, CaLabelOffset> = {
	BBB: { dx: -9, dy: 4, anchor: "end" },
	D66: { dx: 0, dy: 20, anchor: "middle" },
	SGP: { dx: 0, dy: -12, anchor: "middle" },
};
---

<BaseLayout title="Over dit platform - Bipolariteit" class="about">
			<a href="/onderwerpen/" class="back-link">&larr; alle onderwerpen</a>
			<h1>Over dit platform</h1>

			<p class="motto">"We listen and we don't judge."</p>

			<p>
				Deze site ontleedt Nederlandse politieke debatten op argumenten: wie zegt wat, en waarom.
				Voor {topicSlugListText} zet ze de standpunten van Kamerleden en
				partijen naast elkaar, met het letterlijke citaat erbij. Zo zie je in één oogopslag welke
				argumenten er, van welke kant, gebruikt worden. Dat maakt het makkelijk om standpunten te
				vergelijken tussen partijen, personen en door de tijd heen.
			</p>

			<p>
				Dit platform dient ook als <strong>onderwijsmateriaal</strong>: het maakt zichtbaar
				hoe politieke argumentatie in de praktijk werkt, met echte citaten en hun bron, zodat het
				bruikbaar is bij het analyseren van politiek debat.
			</p>

			{
				import.meta.env.PUBLIC_RELEASE_OFFICIEEL !== "true" && (
					<>
						<h2>Ontwikkelversie</h2>
						<p>
							Deze site groeit onderwerp voor onderwerp: elk debat doorloopt crawlen,
							extractie, tagging en een redactiepas in zijn eigen tempo
							{import.meta.env.PUBLIC_RELEASE_TAG
								? ` (versie ${import.meta.env.PUBLIC_RELEASE_TAG})`
								: ""}, zichtbaar terwijl het gebeurt op de <a href="/status/">pipeline-status</a>-pagina.
							Zoekmachines slaan deze versie bewust over.
						</p>
						<p>
							Cijfers en teksten verschuiven mee met de pipeline. Behandel wat je ziet als een
							momentopname, niet als citeerbare bron.
						</p>
					</>
				)
			}

			<h2>Uitgangspunten</h2>
			<ul>
				<li>
					<strong>Geen fact-checking.</strong> We registreren welke getallen en claims genoemd
					worden en door wie, zonder oordeel over of ze kloppen.
				</li>
				<li>
					<strong>Geen eigen perspectief.</strong> Elk argument wordt altijd toegeschreven aan de
					zender ("volgens X…"), nooit gepresenteerd als objectieve waarheid van de site zelf.
				</li>
				<li>
					<strong>Redactionele balans, geen waarheidscheck.</strong> Waar een redactie-pass
					bestaat, checkt die alleen of het tegenperspectief evenwichtig aan bod komt, niet of
					een standpunt feitelijk juist is.
				</li>
				<li>
					<strong>Pro/contra is een classificatie-hulpmiddel.</strong> De indeling in pro/contra,
					toegelicht bovenaan elke topicpagina, ordent het debat, het is geen waardeoordeel over
					welke kant inhoudelijk gelijk heeft.
				</li>
			</ul>

			<h2>Wat is een argument?</h2>
			<p>
				Een argument heeft altijd twee delen, en beide moeten letterlijk in het citaat staan: een <strong>standpunt</strong> (pro/contra/onduidelijk)
				én een <strong>reden of onderbouwing</strong> die dat standpunt ondersteunt. Geen onderbouwing betekent geen argument,
				ook niet als de uitspraak stellig of politiek geladen klinkt.
			</p>

			<div class="argument-schema">
				<p class="argument-schema-kicker">Eén argument, twee delen</p>
				<div class="argument-schema-grid">
					<div class="argument-schema-deel argument-schema-deel-standpunt">
						<p class="argument-schema-label">Standpunt</p>
						<p class="argument-schema-vraag">Wat vindt de spreker van de stelling?</p>
						<div class="argument-schema-varianten">
							<span class="argument-schema-variant argument-schema-variant-pro">Pro</span>
							<span class="argument-schema-variant argument-schema-variant-contra">Contra</span>
							<span class="argument-schema-variant argument-schema-variant-onduidelijk">Onduidelijk</span>
						</div>
					</div>
					<div class="argument-schema-omdat" aria-hidden="true">
						<span></span>omdat<span></span>
					</div>
					<div class="argument-schema-deel argument-schema-deel-onderbouwing">
						<p class="argument-schema-label">Onderbouwing</p>
						<p class="argument-schema-vraag">Wáárom vindt de spreker dat? Een reden, gevolg, voorbeeld of vergelijking.</p>
						<div class="argument-schema-varianten">
							{
								TYPOLOGIES.map((typology) => (
									<span class="argument-schema-variant argument-schema-variant--kleur" style={`--variant-color: ${TYPOLOGY_COLORS[typology]}`}>
										{typologyLabel(typology)}
									</span>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<p>Dit zijn <strong>geen</strong> argumenten, met echte citaten uit de database — het aanwezige deel is onderstreept, het ontbrekende deel is de gestippelde streep:</p>
			<ul class="argument-voorbeelden">
				{
					[
						{
							parts: [{ text: "Ik strijd hier tot de laatste dag om desastreus beleid voor onze boeren en het platteland", type: "standpunt" as const }],
							ontbreekt: "onderbouwing" as const,
							bron: "Caroline van der Plas, BBB",
							label: "Geen onderbouwing",
							toelichting: "een intentie, geen reden.",
						},
						{
							parts: [{ text: "De motie op stuk nr. 470 zou ik willen ontraden", type: "standpunt" as const }],
							ontbreekt: "onderbouwing" as const,
							bron: "minister Van Essen",
							label: "Geen onderbouwing",
							toelichting: "een kaal standpunt zonder reden.",
						},
						{
							parts: [{ text: "Zones rondom Natura 2000-gebieden vinden wij een goed idee; dat is duidelijk", type: "standpunt" as const }],
							ontbreekt: "onderbouwing" as const,
							bron: "Laura Bromet, GroenLinks-PvdA",
							label: "Geen onderbouwing",
							toelichting: "instemming zonder reden.",
						},
						{
							parts: [
								{ text: "Het flauwe antwoord is dat het bij de Raad van State ligt.", type: "plain" as const },
								{ text: " En het is geen afkapgrens, om even scherp te zijn; het is een rekengrens", type: "onderbouwing" as const },
							],
							ontbreekt: "standpunt" as const,
							bron: "minister Van der Wal-Zeggelink",
							label: "Geen stelling",
							toelichting: "een feitelijke verduidelijking, geen standpunt.",
						},
						{
							parts: [
								{
									text: "De antwoorden op de advisering van de Raad van State zullen in het nader rapport, zoals dat heet, worden weerspiegeld",
									type: "onderbouwing" as const,
								},
							],
							ontbreekt: "standpunt" as const,
							bron: "minister Wiersma",
							label: "Geen stelling",
							toelichting: "een procedurele mededeling, geen standpunt.",
						},
					].map((voorbeeld) => (
						<li>
							<p class="argument-quote">
								"{voorbeeld.parts.map((part) => (part.type === "plain" ? part.text : <span class={`arg-${part.type}`}>{part.text}</span>))}."
							</p>
							<p class="argument-ontbreekt">
								<span class="argument-ontbreekt-streep" aria-hidden="true"></span>{voorbeeld.ontbreekt} ontbreekt
							</p>
							<p class="argument-meta">
								<strong>{voorbeeld.label}</strong>: {voorbeeld.bron} — {voorbeeld.toelichting}
							</p>
						</li>
					))
				}
			</ul>
			<p>Dit wél, want standpunt én reden staan er allebei, letterlijk in het citaat:</p>
			<ul class="argument-voorbeelden">
				{
					[
						{
							parts: [
								{ text: "Met dit pakket nemen we de blokkade weg om vergunningen te verlenen.", type: "standpunt" as const },
								{ text: " Alleen met vergunningen kunnen we echt verduurzamen", type: "onderbouwing" as const },
							],
							bron: "Jan Arie Koorevaar, CDA",
							stance: "pro" as const,
							typology: "factual" as const,
							toelichting: "standpunt (vóór het pakket) én reden (het maakt vergunningen weer mogelijk).",
						},
						{
							parts: [
								{ text: "In Nederland kunnen wij zelf keuzes maken over ons eigen lichaam.", type: "standpunt" as const },
								{ text: " Dat is een belangrijke verworvenheid", type: "onderbouwing" as const },
							],
							bron: "Vincent Karremans, VVD",
							stance: "pro" as const,
							typology: "moral" as const,
							toelichting: "standpunt (vóór keuzevrijheid) én reden (het is een verworvenheid).",
						},
					].map((voorbeeld) => (
						<li>
							<p class="argument-quote">
								"{voorbeeld.parts.map((part) => <span class={`arg-${part.type}`}>{part.text}</span>)}."
							</p>
							<p class="argument-meta">
								{voorbeeld.bron}. <strong>Wel een argument</strong>: {voorbeeld.toelichting}
							</p>
						</li>
					))
				}
			</ul>
			<ul class="argument-legend" role="list">
				<li><span class="argument-legend-streep arg-standpunt-streep"></span>standpunt</li>
				<li><span class="argument-legend-streep arg-onderbouwing-streep"></span>onderbouwing</li>
				<li><span class="argument-legend-streep argument-ontbreekt-streep"></span>ontbrekend deel</li>
			</ul>
			<p>
				Ook zuiver procedurele tekst (orde van de vergadering, spreektijd-afspraken, "ik geef het woord
				aan...") levert nooit een argument op. Een uitspraak over de legitimiteit of spelregels van het
				debat zelf telt wél mee als argument, mits onderbouwd, zie de <a href="#argumenttypen">typologie
				"Overig"</a> hieronder.
			</p>
			<p>
				Wie verder wil lezen: <a href="https://plato.stanford.edu/entries/argument/">Stanford Encyclopedia of Philosophy
				over argument en argumentatie</a> voor een algemeen overzicht; Van Eemeren &amp; Grootendorsts <a
				href="https://archive.org/details/systematictheory0000eeme">pragma-dialectische theorie</a> voor het
				standpunt-plus-onderbouwing-model zelf; Douglas Waltons <a
				href="https://en.wikipedia.org/wiki/Argumentation_scheme">argumentatieschema's</a> voor het type
				redeneerpatroon achter de "Walton"-tags in de taxonomie; en <a href="https://aclanthology.org/P19-1463/">Haddadan,
				Cabrio &amp; Villata (2019)</a> voor de externe dataset waartegen deze definitie kwantitatief gevalideerd is (zie{" "}
				<a href="https://github.com/bipolariteit/bipolariteit/blob/main/docs/eval-elecdebate.md">docs/eval-elecdebate.md</a>).
			</p>

			<h2>Hoe de argumenten hier terechtkomen</h2>
			<p>
				Bronnen (op dit moment: Tweede Kamer-debatverslagen) worden per sprekerbeurt gesegmenteerd
				en door een LLM geanalyseerd, dat per beurt 0 of meer argumenten extraheert: een standpunt,
				een citaat, en eventueel genoemde claims met hun bron. Dit is een geautomatiseerd,
				foutgevoelig proces, extractiekwaliteit verbetert nog met de tijd, en je kunt op elke kaart
				feedback geven als iets niet klopt.
			</p>

			<ol class="workflow" role="list">
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">1</span> Crawlen</p>
					<p class="workflow-step-detail">
						Debatverslagen worden opgehaald bij de open data van de Tweede Kamer. Geen LLM, dus dit mag
						altijd draaien.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">2</span> Segmenteren</p>
					<p class="workflow-step-detail">Eén verslag (een heel debat) wordt opgeknipt per sprekerbeurt.</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">3</span> Argumenten-extractie</p>
					<p class="workflow-step-detail">
						Een lokaal LLM haalt per sprekerbeurt 0 of meer argumenten eruit: standpunt, typologie,
						citaat, eventuele claims.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">4</span> Tags toekennen</p>
					<p class="workflow-step-detail">
						Tags uit de taxonomie hieronder worden toegekend: drie labelgroepen deterministisch, de
						rest via hetzelfde lokale LLM.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">5</span> Bias-check</p>
					<p class="workflow-step-detail">
						Een bias-balanssnapshot per document plus een koppeling naar tegenargumenten. Geen
						feitelijke-juistheidscheck.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">6</span> Steekproefcontrole</p>
					<p class="workflow-step-detail">
						Vóór elke publicatieronde herbeoordelen een mens en Gemini een representatieve
						steekproef; de resultaten staan in de <a href="/validatie-rapportage">validatie-rapportage</a>.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">7</span> Export &amp; publicatie</p>
					<p class="workflow-step-detail">
						De resultaten worden geëxporteerd en de site wordt daarop statisch gebouwd, zonder server of
						eigen database.
					</p>
				</li>
			</ol>

			<h2 id="argumenttypen">Standpunt &amp; typologie</h2>
			<p>
				Elk argument krijgt tijdens de argumenten-extractie een <strong>standpunt</strong> (de kleur van de kaart) en, om meteen aan te
				geven wat voor soort onderbouwing erbij hoort, een <strong>typologie</strong> (het label bovenaan de kaart) mee. Standpunt en
				typologie zijn onafhankelijk van elkaar: een moreel argument kan net zo goed vóór als tegen zijn. Wat "pro" en "contra"
				concreet betekenen is per onderwerp gedefinieerd en staat toegelicht bovenaan elke topicpagina.
			</p>
			<div class="card-group">
				<div class="card-group-item">
					<div class="card-group-item-header">
						<h3>Standpunt</h3>
					</div>
					<div class="card-grid">
						{
							STANCES.map((stance) => (
								<div class="card-item card-item--accent" style={`--card-item-accent: var(--color-${stance === "unclear" ? "unclear" : stance})`}>
									<div class="card-item-body">
										<div class="card-item-head">
											<span class="card-item-title">{stanceLabel(stance)}</span>
											<span class="card-item-meta">{stanceCounts.get(stance) ?? 0}x</span>
										</div>
										<span class="card-item-description">{stanceDescription(stance)}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
				<div class="card-group-item">
					<div class="card-group-item-header">
						<h3>Onderbouwing (typologie)</h3>
					</div>
					<div class="card-grid">
						{
							TYPOLOGIES.map((typology) => (
								<div class="card-item card-item--accent" style="--card-item-accent: var(--color-muted)">
									<div class="card-item-body">
										<div class="card-item-head">
											<span class="card-item-title">{typologyLabel(typology)}</span>
											<span class="card-item-meta">{typologyCounts.get(typology) ?? 0}x</span>
										</div>
										<span class="card-item-description">{typologyDescription(typology)}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>

			<h2>Tags beschrijven de vorm van een argument</h2>
			<p>
				Naast stance/typologie krijgen argumenten waar mogelijk ook tags uit een argumentatietheoretische
				taxonomie (o.a. redeneerschema's, en, in de labelgroep "Dialectische Kwaliteit"/"Metadiscussie",
				retorische patronen zoals stropop of ad-hominem). Een tag zegt iets over de <strong>vorm</strong> van
				een fragment: "dit heeft de vorm van een ad-hominem-constructie." Deze taxonomie-laag is minder
				uitgebreid gevalideerd dan stance/typologie en kan foutgevoeliger zijn bij subtiele gevallen, zie de
				validatie-rapportage hieronder voor de laatste steekproefresultaten.
			</p>
			<p>
				De taxonomie is verdeeld in vier perspectieven, elk met een eigen kleur die overal op de site
				hetzelfde blijft (correspondentiekaart, tag-grafieken, hieronder). Dit overzicht toont elke tag die
				op dit moment ergens is toegekend, met beschrijving en het aantal toekenningen over alle
				onderwerpen heen.
			</p>

			<div class="card-group">
				{
					taxonomie.map((perspectief) => (
						<div class="card-group-item" style={`--card-group-item-accent: ${perspectief.kleur}`}>
							<div class="card-group-item-header">
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke={perspectief.kleur} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d={ICOON_PAD[perspectief.icoon]} />
								</svg>
								<h3>{perspectiefWeergaveNaam(perspectief.naam)}</h3>
							</div>
							{perspectief.labelgroepen.map((labelgroep) => (
								<div class="card-section">
									<span class="card-section-title">{labelgroep.naam}</span>
									<div class="card-grid">
										{labelgroep.tags.map((tag) => (
											<div class="card-item">
												{tagIconPath(tag.sleutel) && (
													<svg
														class="card-item-icon"
														viewBox="0 0 24 24"
														width="20"
														height="20"
														fill="none"
														stroke={perspectief.kleur}
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
													>
														<path d={tagIconPath(tag.sleutel)!} />
													</svg>
												)}
												<div class="card-item-body">
													<div class="card-item-head">
														<span class="card-item-title">{tag.sleutel}</span>
														<span class="card-item-meta">{tag.count}x</span>
													</div>
													<span class="card-item-description">{tag.beschrijving}</span>
												</div>
											</div>
										))}
									</div>
								</div>
							))}
						</div>
					))
				}
			</div>

			<h2 id="favoriete-tags-methode">Hoe favoriete en minst favoriete tags worden bepaald</h2>
			<p>
				De <a href="/personen/">personenlijst</a> toont per spreker een <strong>favoriet</strong> (★) en een{" "}
				<strong>minst favoriet</strong> (☆) tag. Dit gaat alleen over de tags uit de argumentatietheoretische
				taxonomie hierboven (LLM-toegekend); afgeleide tags als Arena-Parlement of Actor-Politicus volgen
				mechanisch uit metadata en zeggen niets over iemands eigen argumentatiestijl, dus die tellen niet mee.
			</p>
			<p>
				Voor elke tag vergelijken we het aandeel dat een spreker 'm zelf gebruikt (van hun eigen getagde
				argumenten) met het aandeel over alle sprekers heen. Een <strong>ratio</strong> boven 1 betekent: deze
				spreker gebruikt de tag vaker dan gemiddeld; onder 1 betekent minder vaak.
			</p>
			<ul>
				<li>
					<strong>Favoriet</strong> is de tag met de hoogste ratio, met als ondergrens dat de tag in
					minstens 5% van iemands eigen getagde argumenten voorkomt. Zonder die ondergrens zou een enkele
					toekenning op een klein volume al een torenhoge (maar betekenisloze) ratio geven.
				</li>
				<li>
					<strong>Minst favoriet</strong> is de tag met de laagste ratio, vaak 0 (nooit gebruikt). Bij een
					gelijke stand (meerdere tags die iemand nooit gebruikt) telt de tag die over alle sprekers heen
					het vaakst voorkomt: een tag die verder gangbaar is maar deze spreker nooit gebruikt, is
					interessanter dan een obscure tag die toch bijna niemand gebruikt.
				</li>
			</ul>
			<p class="panel-note">
				Bij weinig getagde argumenten is dit minder betrouwbaar; hover over een badge voor de exacte aantallen
				en de ratio.
			</p>

			<h2 id="correspondentiekaart-methode">Wat is een correspondentiekaart?</h2>
			<p>
				Elke topicpagina toont een <strong>correspondentiekaart</strong>: partijen (of personen) en tags
				samen in één plaatje. Punten die dicht bij elkaar staan, horen bij elkaar: twee partijen dicht bij
				elkaar gebruiken vergelijkbare soorten argumenten, twee tags dicht bij elkaar worden vaak samen
				toegekend. Een tag dicht bij een partij betekent dat die partij die tag relatief vaak gebruikt, niet
				per se vaker dan andere partijen in absolute aantallen, maar relatief tot haar eigen totaal.
			</p>
			<p>
				De kaart is interactief: klik op een punt om erop te filteren, of wissel bovenaan de kaart tussen
				partijen en personen als rijen. Ze draait volledig in de browser (de techniek heet <em>correspondentieanalyse</em>,
				afgekort CA), zodat ze live meebeweegt met het filter bovenaan de pagina.
			</p>

			<h3>Hoe de kaart tot stand komt</h3>
			<p>
				We beginnen met een voorbeeld: een echte uitsnede uit de huidige data (drie partijen, drie tags, de
				volledige kaart gebruikt alle partijen/personen en alle toegekende tags tegelijk). Deze drie tags:
			</p>

			<div class="ca-example-tag-chips">
				{
					caExampleTags.map((sleutel) => (
						<div class="card-item">
							{tagIconPath(sleutel) && (
								<svg
									class="card-item-icon"
									viewBox="0 0 24 24"
									width="20"
									height="20"
									fill="none"
									stroke={caExampleKleur}
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d={tagIconPath(sleutel)!} />
								</svg>
							)}
							<div class="card-item-body">
								<span class="card-item-title">{sleutel}</span>
								<span class="card-item-description">{tagUsage.get(sleutel)?.beschrijving}</span>
							</div>
						</div>
					))
				}
			</div>

			<div class="table-scroll">
				<table class="party-table ca-example-table">
					<thead>
						<tr>
							<th scope="col">Partij</th>
							<th scope="col">Ideologie-GAL</th>
							<th scope="col">Ideologie-TAN</th>
							<th scope="col">Moraliteit-Autoriteit</th>
							<th scope="col">Rijtotaal</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">BBB</th>
							<td>7</td>
							<td>146</td>
							<td>87</td>
							<td>240</td>
						</tr>
						<tr>
							<th scope="row">D66</th>
							<td>166</td>
							<td>0</td>
							<td>42</td>
							<td>208</td>
						</tr>
						<tr>
							<th scope="row">SGP</th>
							<td>1</td>
							<td>85</td>
							<td>19</td>
							<td>105</td>
						</tr>
						<tr>
							<th scope="row">Tagtotaal</th>
							<td>174</td>
							<td>231</td>
							<td>148</td>
							<td>553</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p>
				D66 gebruikt Ideologie-GAL in 166 van de 208 toekenningen (80%) en Ideologie-TAN vrijwel nooit. BBB
				en SGP zijn het spiegelbeeld: samen goed voor 231 van de 231 Ideologie-TAN-toekenningen en nauwelijks
				Ideologie-GAL. Moraliteit-Autoriteit wijst niet zomaar naar dezelfde plek als Ideologie-TAN: BBB
				gebruikt die tag relatief vaker (87 van de 240, 36%) dan SGP (19 van de 105, 18%), een nuance die in
				een kale TAN/GAL-indeling verloren zou gaan.
			</p>

			<p>
				Correspondentieanalyse (CA) zet dat soort verschil om in een positie op de kaart. Toegepast op precies
				deze tabel (zonder de weergave-compressie uit de laatste stap hieronder, bij drie rijen en drie tags
				is er nog niets te comprimeren):
			</p>

			<div class="ca-example-chart">
				<svg viewBox="0 0 460 300" role="img" aria-label={`Correspondentiekaart van het voorbeeld: D66 (${caExample.rows[1].coords[0].toFixed(2)}, ${caExample.rows[1].coords[1].toFixed(2)}) staat ver van BBB (${caExample.rows[0].coords[0].toFixed(2)}, ${caExample.rows[0].coords[1].toFixed(2)}) en SGP (${caExample.rows[2].coords[0].toFixed(2)}, ${caExample.rows[2].coords[1].toFixed(2)}), die dicht bij elkaar en bij Ideologie-TAN clusteren; D66 staat dicht bij Ideologie-GAL.`}>
					<line x1={CA_CX} y1="10" x2={CA_CX} y2="290" class="ca-example-axis" />
					<line x1="10" y1={CA_CY} x2="450" y2={CA_CY} class="ca-example-axis" />
					<text x={CA_CX + 4} y="22" class="ca-example-axis-label">dim. 2 ({caExample.inertiaPct[1]}%)</text>
					<text x="446" y={CA_CY - 6} class="ca-example-axis-label" text-anchor="end">dim. 1 ({caExample.inertiaPct[0]}%)</text>

					{
						caExample.tags.map((tag) => {
							const p = caPoint(tag.coords);
							// Labels met de hand gepositioneerd (niet één uniforme "boven het
							// punt"-regel): Ideologie-TAN en Moraliteit-Autoriteit liggen zo dicht
							// bij respectievelijk SGP en BBB dat een vaste regel de labels over
							// elkaar heen zou leggen.
							const label = CA_TAG_LABEL_OFFSET[tag.sleutel] ?? { dx: 0, dy: -11, anchor: "middle" as const };
							return (
								<g>
									<rect x={p.x - 5} y={p.y - 5} width="10" height="10" transform={`rotate(45 ${p.x} ${p.y})`} fill={caExampleKleur} />
									<text x={p.x + label.dx} y={p.y + label.dy} class="ca-example-point-label ca-example-tag-label" text-anchor={label.anchor}>
										{tag.sleutel}
									</text>
								</g>
							);
						})
					}
					{
						caExample.rows.map((row) => {
							const p = caPoint(row.coords);
							const label = CA_ROW_LABEL_OFFSET[row.label] ?? { dx: 0, dy: 20, anchor: "middle" as const };
							return (
								<g>
									<circle cx={p.x} cy={p.y} r="6" class="ca-example-row-point" />
									<text x={p.x + label.dx} y={p.y + label.dy} class="ca-example-point-label" text-anchor={label.anchor}>
										{row.label}
									</text>
								</g>
							);
						})
					}
				</svg>
				<p class="ca-example-chart-caption">
					Ruit = tag, cirkel = partij. Resultaat: D66 komt ver van BBB en SGP te liggen, dicht bij
					Ideologie-GAL; BBB en SGP clusteren aan de Ideologie-TAN-kant, met BBB net iets dichter bij
					Moraliteit-Autoriteit dan SGP.
				</p>
			</div>

			<p>Dat gebeurt in zes stappen:</p>

			<ol class="workflow" role="list">
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">1</span> Tellen</p>
					<p class="workflow-step-detail">
						Voor elke combinatie van rij (partij of persoon) en tag: hoeveel argumenten hebben die
						combinatie? Dat leverde de tabel hierboven op. Alleen LLM-toegekende tags tellen mee, de
						drie deterministisch afgeleide labelgroepen staan bij vrijwel elk argument en zouden geen
						signaal toevoegen. Rijen en tags met te weinig toekenningen vallen weg; onder drie rijen of
						drie tags stopt de analyse (te weinig voor een zinnige uitspraak).
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">2</span> Afwijking van "geen verband"</p>
					<p class="workflow-step-detail">
						Elke cel wordt vergeleken met wat je zou verwachten als rij en tag niets met elkaar te
						maken hadden (rijgrootte × tagpopulariteit). Wat overblijft is een tabel met residuen: hoe
						sterk, en in welke richting, wijkt elke combinatie af van dat neutrale nulpunt.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">3</span> Assen zoeken (SVD)</p>
					<p class="workflow-step-detail">
						Een singuliere-waardenontbinding vindt de assen waarlangs die afwijkingen het sterkst
						uiteenlopen. De eerste assen vangen het meeste patroon: hun aandeel staat als
						percentage (verklaarde inertie) bij elke as op de kaart.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">4</span> Coördinaten</p>
					<p class="workflow-step-detail">
						Rijen én tags krijgen allebei een positie op diezelfde assen. Daardoor is de afstand
						tussen twee rijen onderling, en tussen twee tags onderling, interpreteerbaar, maar de
						afstand van een rij tot een tag alleen richtinggewijs, niet als letterlijke maat.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">5</span> Tekenconventie</p>
					<p class="workflow-step-detail">
						De ontbinding uit stap 3 legt geen teken vast: een as mag zonder betekenisverschil
						spiegelen. Zonder correctie zou de kaart dus willekeurig links-rechts of boven-onder
						omklappen zodra er nieuwe data bijkomt. Een vaste oriëntatieregel voorkomt dat.
					</p>
				</li>
				<li class="workflow-arrow" aria-hidden="true">↓</li>
				<li class="workflow-step">
					<p class="workflow-step-title"><span class="workflow-step-index">6</span> Weergave-compressie</p>
					<p class="workflow-step-detail">
						Eén zeldzame tag kan een afstand tot de kern hebben die de rest van de puntenwolk tot een
						vlekje samenperst. Vlak vóór het tekenen worden dat soort uitschieters radiaal naar de
						kern getrokken (richting blijft gelijk). Dit is puur een weergavetruc, ná de echte
						analyse: afstanden op de kaart zijn daardoor geen letterlijke chi-kwadraatafstanden meer,
						alleen richting en relatieve volgorde blijven behouden.
					</p>
				</li>
			</ol>

			<h2>Transparantie &amp; reproduceerbaarheid</h2>
			<p>
				We claimen geen feilloosheid, wel traceerbaarheid: elk argument is te herleiden tot het exacte
				model, de exacte promptversie en de brontekst waaruit het is gedestilleerd.
			</p>
			<ul>
				<li>
					<strong>Databronnen.</strong> De debatverslagen komen van de{" "}
					<a href="https://opendata.tweedekamer.nl">Open Data van de Tweede Kamer</a> (OData-API, VLOS-XML
					van elke Vergadering/Verslag) — bij elk argument staat een link naar zowel deze ruwe brondata als
					naar de bijbehorende officiële <a href="https://www.tweedekamer.nl">tweedekamer.nl</a>-pagina van
					het debat. Video's linken naar{" "}
					<a href="https://debatdirect.tweedekamer.nl">Debat Direct</a>, de officiële videowebsite van de
					Tweede Kamer.
				</li>
				<li>
					<strong>Modellen &amp; promptversies.</strong> Argumenten-extractie, tagging en de bias-check draaien lokaal
					via een open-source model (momenteel <code>qwen/qwen3.6-27b</code>);
					validatiesteekproeven gebruiken daarnaast Gemini als tweede beoordelaar. Van elk argument wordt
					bijgehouden met welke promptversie het gemaakt is, zodat een prompt- of modelwijziging altijd
					traceerbaar is.
				</li>
				<li>
					<strong>Validatie-rapportage.</strong> Vóór elke publicatieronde wordt een representatieve
					steekproef per onderwerp handmatig + door een tweede LLM herbeoordeeld. Zie de <a href="/validatie-rapportage">validatie-rapportage</a> voor
					de laatste resultaten (foutpercentage en systematische patronen per stage).
				</li>
				<li>
					<strong>Open werkwijze.</strong> De volledige pipeline, prompts en taxonomie staan in de broncode
					van dit platform, niet alleen in deze uitleg. Zie de <a href="https://github.com/bipolariteit/bipolariteit">broncode op GitHub</a>.
				</li>
			</ul>
</BaseLayout>
