---
import TagDetail from "../../components/TagDetail.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ALLE_TAGS } from "../../lib/taxonomy";
import { slugify } from "../../lib/slug";
import { derivePartyTagIndex, derivePersonTagIndex, deriveTopPersonsForTag } from "../../lib/aggregate";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

function allArguments() {
	return Object.values(topicModules).flatMap((mod: any) => mod.default.arguments);
}

export function getStaticPaths() {
	return ALLE_TAGS.map((tag) => ({
		params: { sleutel: slugify(tag.sleutel) },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const argumentList = allArguments();
const dataBaseUrl = import.meta.env.PUBLIC_DATA_BASE_URL ?? "https://cdn.jsdelivr.net/gh/bipolariteit/bipolariteit-data@main";

// De argumenten met déze tag (tot ~10 MB voor de grootste tags) gaan niet meer
// als Astro-prop mee -- TagDetail.vue fetcht ze client-side vanaf
// scripts/export_public_data.ts's output (issue #163). De
// partij-/persoonpercentages hebben wel de volledige lijst als noemer nodig
// (alle onderwerpen), dus die aggregatie blijft hier, build-time, en alleen
// de kleine uitkomst (partyRows/topPersons) gaat mee als prop.

// Zelfde ondergrens als TagDetail.vue/PerspectiefTagHeatmap.vue: onder dit
// partijtotaal is een percentage schijnnauwkeurig.
const MIN_PARTY_TOTAL = 8;

let partyRows: { party: string; count: number; total: number; pct: number }[] = [];
let topPersons: ReturnType<typeof deriveTopPersonsForTag> = [];
if (!tag.deterministic) {
	const partyIndex = derivePartyTagIndex(argumentList);
	for (const entry of partyIndex.values()) {
		if (entry.total < MIN_PARTY_TOTAL) continue;
		const count = entry.tagCounts.get(tag.sleutel) ?? 0;
		if (!count) continue;
		partyRows.push({ party: entry.party, count, total: entry.total, pct: (count / entry.total) * 100 });
	}
	partyRows.sort((a, b) => b.pct - a.pct);
	topPersons = deriveTopPersonsForTag(derivePersonTagIndex(argumentList), tag.sleutel);
}
---

<BaseLayout title={`${tag.sleutel} - Bipolariteit`}>
	<a href="/tags/" class="back-link">&larr; alle tags</a>
	<TagDetail
		sleutel={tag.sleutel}
		beschrijving={tag.beschrijving}
		labelgroep={tag.labelgroep}
		perspectief={tag.perspectief}
		deterministic={tag.deterministic}
		partyRows={partyRows}
		topPersons={topPersons}
		dataBaseUrl={dataBaseUrl}
		client:only="vue"
	/>
</BaseLayout>
