---
import DebateVideoView from "../../components/DebateVideoView.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { debateName } from "../../lib/debateName";
import { resolveDataBaseUrl } from "../../lib/dataBaseUrl";
import { getDebateStaticPaths } from "../../lib/debateStaticPaths";
import { formatDate } from "../../lib/formatDate";

// Route puur op debateId(raw_video_url), niet genest onder een topic-slug:
// welke links (persoon/topic-pagina's) hier precies naartoe gaan verwijzen
// staat nog niet vast, dus deze route mag topic-onafhankelijk zijn.

export function getStaticPaths() {
	return getDebateStaticPaths();
}

const { topicSlug, videoUrl, rawVideoUrl, posterUrl, publishedAt } = Astro.props;
const { id } = Astro.params;
const name = debateName(videoUrl);
const title = `${name ?? "Debat"} - Bipolariteit`;
---

<BaseLayout title={title}>
	<a href={`/onderwerpen/${topicSlug}/`} class="back-link">&larr; terug naar {topicSlug}</a>
	<h1 class="debate-title">{name ?? "Debat"}</h1>
	<p class="debate-date mono">{formatDate(publishedAt)}</p>
	<DebateVideoView
		debateId={id}
		topicSlug={topicSlug}
		dataBaseUrl={resolveDataBaseUrl()}
		rawVideoUrl={rawVideoUrl}
		posterUrl={posterUrl}
		embedUrl={`/embed/debatten/${id}/`}
		client:only="vue"
	/>
</BaseLayout>

<style>
	.debate-title {
		margin-top: var(--space-1);
		margin-bottom: 0;
	}

	.debate-date {
		font-size: var(--step--1);
		font-weight: 500;
		color: var(--galnoot-zacht);
		margin-top: 0;
	}
</style>
