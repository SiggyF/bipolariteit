---
import SiteNav from "../../components/SiteNav.astro";
import { slugify } from "../../lib/slug";
import "../../styles/main.css";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

const counts = new Map<string, number>();
for (const mod of Object.values(topicModules) as any[]) {
	for (const argument of mod.default.arguments) {
		counts.set(argument.actor.name, (counts.get(argument.actor.name) ?? 0) + 1);
	}
}
const persons = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Personen — Bipolariteit</title>
	</head>
	<body>
		<SiteNav />
		<main>
			<a href="/" class="back-link">&larr; alle onderwerpen</a>
			<h1>Personen</h1>
			<p class="intro">Welke tags een spreker gebruikt en hoe vaak, over alle onderwerpen heen.</p>
			<ul class="topic-list">
				{persons.map(([name, count]) => (
					<li>
						<a href={`/persoon/${slugify(name)}/`}>
							<span class="topic-name">{name}</span>
							<span class="topic-count">{count} argumenten</span>
						</a>
					</li>
				))}
			</ul>
		</main>
	</body>
</html>
