---
import TopicView from "../../components/TopicView.vue";
import FeedbackExport from "../../components/FeedbackExport.vue";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/main.css";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });
	return Object.values(modules).map((mod: any) => ({
		params: { slug: mod.default.slug },
	}));
}

const { slug } = Astro.params;
const mod: any = Object.values(topicModules).find((m: any) => m.default.slug === slug);
const topic = mod.default;
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{topic.name} — Bipolariteit</title>
	</head>
	<body>
		<SiteNav />
		<main>
			<a href="/" class="back-link">&larr; alle onderwerpen</a>
			<div class="topic-header">
				<h1>{topic.name}</h1>
				{topic.description && <p class="topic-description">{topic.description}</p>}
			</div>

			{/* Eén island voor alles wat op het filter reageert: de grafieken en de
			    kolommen delen zo dezelfde argumentenlijst en filterstore. Ook
			    scheelt het serialiseren -- het corpus is enkele MB's groot en zou
			    anders per island in de HTML terechtkomen. client:only omdat de
			    filterstore de URL leest, wat op de server niet bestaat. */}
			<TopicView
				argumentList={topic.arguments}
				topicSlug={topic.slug}
				correspondence={topic.tag_correspondence}
				client:only="vue"
			/>

			<FeedbackExport client:load />
		</main>
	</body>
</html>
