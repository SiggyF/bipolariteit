---
import ArgumentColumn from "../../components/ArgumentColumn.vue";
import StatsPanel from "../../components/StatsPanel.vue";
import TagsPerParty from "../../components/TagsPerParty.vue";
import TagCorrespondenceMap from "../../components/TagCorrespondenceMap.vue";
import FeedbackExport from "../../components/FeedbackExport.vue";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/main.css";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });
	return Object.values(modules).map((mod: any) => ({
		params: { slug: mod.default.slug },
	}));
}

const { slug } = Astro.params;
const mod: any = Object.values(topicModules).find((m: any) => m.default.slug === slug);
const topic = mod.default;
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{topic.name} — Bipolariteit</title>
	</head>
	<body>
		<SiteNav />
		<main>
			<a href="/" class="back-link">&larr; alle onderwerpen</a>
			<h1>{topic.name}</h1>
			{topic.description && <p class="topic-description">{topic.description}</p>}

			<StatsPanel stats={topic.stats} client:only="vue" />
			<TagsPerParty tagsPerParty={topic.tags_per_party} client:only="vue" />
			<TagCorrespondenceMap correspondence={topic.tag_correspondence} client:only="vue" />

			<div class="columns">
				<ArgumentColumn arguments={topic.pro} topicSlug={topic.slug} label="Pro" stanceClass="column-pro" client:load />
				<ArgumentColumn arguments={topic.contra} topicSlug={topic.slug} label="Contra" stanceClass="column-contra" client:load />
				<ArgumentColumn arguments={topic.unclear} topicSlug={topic.slug} label="Onduidelijk" stanceClass="column-unclear" client:load />
			</div>

			<FeedbackExport client:load />
		</main>
	</body>
</html>
