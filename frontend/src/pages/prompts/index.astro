---
import BaseLayout from "../../layouts/BaseLayout.astro";
import topicsIndex from "../../../../data/export/topics-index.json";
---

<BaseLayout title="Prompts - Bipolariteit" class="about status-page">
	<a href="/status/" class="back-link">&larr; status</a>
	<h1>Prompts &amp; respons</h1>
	<p class="panel-note">Per onderwerp de meest recente LLM-calls: gebruikte prompt, model, duur en respons.</p>

	<div class="card-grid">
		{topicsIndex.map((topic) => (
			<a href={`/prompts/${topic.slug}/`} class="card-item">
				<div class="card-item-body">
					<span class="card-item-title">{topic.name}</span>
				</div>
			</a>
		))}
	</div>
</BaseLayout>
