---
import PerspectiefView from "../../components/PerspectiefView.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PERSPECTIEVEN } from "../../lib/tagIcons.generated";
import { slugify } from "../../lib/slug";
import { perspectiefWeergaveNaam } from "../../lib/tagIcon";
import { toLeanArgument } from "../../lib/leanArgument";
import { derivePartyTagIndex, derivePersonTagIndex, serializePartyTagIndex, serializePersonTagIndex } from "../../lib/aggregate";
import type { Argument } from "../../lib/types";

// Alleen nog gebruikt om build-time de partij-/persoonindex over het hele
// corpus uit te rekenen (zie hieronder) -- de ruwe argumentenlijst zelf gaat
// niet meer als prop mee naar de client. De perspectief-gefilterde
// argumentenlijst die de tijdlijn/kaart nodig hebben wordt door
// PerspectiefView.vue client-side via jsDelivr gefetcht vanaf de publieke
// bipolariteit/bipolariteit-data-repo (zie scripts/export_public_data.ts),
// zodat deze pagina nooit meer de volledige dataset in de HTML bakt (issue
// #163: Cloudflare Workers-assetlimiet van 25 MiB per bestand -- elke
// perspectiefpagina zat hier ~18-21 MB overheen).
const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

function allArguments(): Argument[] {
	return Object.values(topicModules).flatMap((mod: any) => mod.default.arguments.map(toLeanArgument));
}

export function getStaticPaths() {
	return PERSPECTIEVEN.map((p) => ({
		params: { naam: slugify(p.naam) },
		props: { perspectief: p.naam },
	}));
}

const { perspectief } = Astro.props;
const argumentList = allArguments();
const partyIndex = serializePartyTagIndex(derivePartyTagIndex(argumentList));
const personIndex = serializePersonTagIndex(derivePersonTagIndex(argumentList));
const dataBaseUrl = import.meta.env.PUBLIC_DATA_BASE_URL ?? "https://cdn.jsdelivr.net/gh/bipolariteit/bipolariteit-data@main";
---

<BaseLayout title={`${perspectiefWeergaveNaam(perspectief)} - Bipolariteit`}>
	<a href="/perspectieven/" class="back-link">&larr; alle perspectieven</a>
	<PerspectiefView
		perspectief={perspectief}
		partyIndex={partyIndex}
		personIndex={personIndex}
		dataBaseUrl={dataBaseUrl}
		client:only="vue"
	/>
</BaseLayout>
