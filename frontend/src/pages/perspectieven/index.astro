---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityTabs from "../../components/EntityTabs.astro";
import { PERSPECTIEVEN } from "../../lib/tagIcons.generated";
import { slugify } from "../../lib/slug";
import { perspectiefWeergaveNaam, perspectiefKleurVar } from "../../lib/tagIcon";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

const tagPerspectief = new Map<string, string>();
for (const perspectief of PERSPECTIEVEN) {
	for (const sleutel of Object.keys(perspectief.tags)) tagPerspectief.set(sleutel, perspectief.naam);
}

const counts = new Map<string, number>();
for (const mod of Object.values(topicModules) as any[]) {
	for (const argument of mod.default.arguments) {
		for (const tag of argument.tags) {
			if (tag.created_by !== "llm") continue;
			counts.set(tag.perspectief, (counts.get(tag.perspectief) ?? 0) + 1);
		}
	}
}

const perspectieven = PERSPECTIEVEN.map((p) => ({
	naam: p.naam,
	kleur: perspectiefKleurVar(p.naam),
	count: counts.get(p.naam) ?? 0,
}));
---

<BaseLayout title="Perspectieven - Bipolariteit">
	<a href="/onderwerpen/" class="back-link">&larr; alle onderwerpen</a>
	<EntityTabs />
	<h1>Perspectieven</h1>
	<p class="intro">
		Welke partij welke tags gebruikt en hoe vaak, per perspectief uit de taxonomie, over alle onderwerpen heen.
	</p>
	<ul class="topic-list">
		{perspectieven.map((p) => (
			<li>
				<a href={`/perspectieven/${slugify(p.naam)}/`}>
					<span class="perspectief-list-name">
						<span class="perspectief-swatch" style={`background:${p.kleur}`}></span>
						<span class="topic-name">{perspectiefWeergaveNaam(p.naam)}</span>
					</span>
					<span class="topic-count">{p.count}x toegekend</span>
				</a>
			</li>
		))}
	</ul>
</BaseLayout>
