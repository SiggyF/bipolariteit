---
import ActorTagUsage from "../../components/ActorTagUsage.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { NO_PARTY } from "../../lib/types";
import { slugify } from "../../lib/slug";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

function allArguments() {
	return Object.values(topicModules).flatMap((mod: any) =>
		mod.default.arguments.map((argument: any) => ({
			...argument,
			topicSlug: mod.default.slug,
			topicName: mod.default.name,
		})),
	);
}

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });
	const parties = new Set<string>();
	for (const mod of Object.values(modules) as any[]) {
		for (const argument of mod.default.arguments) {
			if (argument.actor.party && argument.actor.party !== NO_PARTY) parties.add(argument.actor.party);
		}
	}
	return [...parties].map((party) => ({
		params: { naam: slugify(party) },
		props: { party },
	}));
}

const { naam } = Astro.params;
const allArgs = allArguments();
const party =
	Astro.props.party ??
	allArgs.find((a: any) => a.actor.party && slugify(a.actor.party) === naam)?.actor.party;

const argumentList = allArgs.filter((a: any) => a.actor.party === party);
---

<BaseLayout title={`${party || "Partij"} — Bipolariteit`}>
	<a href="/" class="back-link">&larr; alle onderwerpen</a>
	{party && <ActorTagUsage name={party} mode="partij" argumentList={argumentList} client:only="vue" />}
</BaseLayout>
