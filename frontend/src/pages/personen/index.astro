---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityTabs from "../../components/EntityTabs.astro";
import PartyIcon from "../../components/PartyIcon.astro";
import TagSignaalBadge from "../../components/TagSignaalBadge.astro";
import { displayPartyName, canonicalParty } from "../../lib/parties";
import { slugify } from "../../lib/slug";
import { NO_PARTY } from "../../lib/types";
import { PERSPECTIEVEN } from "../../lib/tagIcons.generated";
import { berekenTagSignalen, signaalTitle } from "../../lib/tagSignalen";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

const PERSPECTIEF_KLEUR = new Map(PERSPECTIEVEN.map((p) => [p.naam, p.kleur]));
const TAG_PERSPECTIEF = new Map<string, string>();
for (const perspectief of PERSPECTIEVEN) {
	for (const sleutel of Object.keys(perspectief.tags)) TAG_PERSPECTIEF.set(sleutel, perspectief.naam);
}
const ONBEKENDE_KLEUR = "#6f6558";

const counts = new Map<string, number>();
const partyOf = new Map<string, string>();
const tagBeschrijving = new Map<string, string>();

// Alleen LLM-toegekende tags karakteriseren iemands eigen argumentatiestijl --
// afgeleide tags (Arena-Parlement, Actor-Politicus, ...) volgen mechanisch uit
// metadata en zeggen niets over wat iemand "kenmerkt", zie ook aggregate.ts.
const tagCountByPerson = new Map<string, Map<string, number>>();
const tagTotalByPerson = new Map<string, number>();
const globalTagCount = new Map<string, number>();
let globalTagTotal = 0;

for (const mod of Object.values(topicModules) as any[]) {
	for (const argument of mod.default.arguments) {
		const name = argument.actor.name;
		counts.set(name, (counts.get(name) ?? 0) + 1);
		if (argument.actor.party && !partyOf.has(name)) partyOf.set(name, canonicalParty(argument.actor.party));

		const personTagCount = tagCountByPerson.get(name) ?? new Map<string, number>();
		for (const tag of argument.tags) {
			if (tag.created_by !== "llm") continue;
			if (!tagBeschrijving.has(tag.sleutel)) tagBeschrijving.set(tag.sleutel, tag.beschrijving);
			personTagCount.set(tag.sleutel, (personTagCount.get(tag.sleutel) ?? 0) + 1);
			tagTotalByPerson.set(name, (tagTotalByPerson.get(name) ?? 0) + 1);
			globalTagCount.set(tag.sleutel, (globalTagCount.get(tag.sleutel) ?? 0) + 1);
			globalTagTotal++;
		}
		tagCountByPerson.set(name, personTagCount);
	}
}

const ICOON_STER = "M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z";

const persons = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Personen - Bipolariteit">
	<a href="/onderwerpen/" class="back-link">&larr; alle onderwerpen</a>
	<EntityTabs />
	<h1>Personen</h1>
	<p class="intro">
		Welke tags een spreker gebruikt en hoe vaak, over alle onderwerpen heen. Klik op een persoon voor een profiel:
		top 3 favoriete en minst favoriete tags, een staafdiagram van het tag-gebruik, en voorbeeldargumenten per
		onderwerp.
	</p>
	<div class="person-list-head">
		<span>Persoon</span>
		<span class="person-list-head-signalen">
			<svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" stroke="none"><path d={ICOON_STER} /></svg>
			favoriet
			<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75"><path d={ICOON_STER} /></svg>
			minst favoriet
			<a href="/over/#favoriete-tags-methode" class="info-link" title="Hoe favoriet/minst favoriet bepaald wordt" aria-label="Uitleg: hoe favoriet en minst favoriet bepaald worden">?</a>
		</span>
		<span>Argumenten</span>
	</div>
	<ul class="topic-list person-list">
		{persons.map(([name, count]) => {
			const party = partyOf.get(name);
			const personTagCount = tagCountByPerson.get(name) ?? new Map<string, number>();
			const personTotal = tagTotalByPerson.get(name) ?? 0;
			const { favorieten, minstFavoriet } = berekenTagSignalen(personTagCount, personTotal, globalTagCount, globalTagTotal);
			const favoriet = favorieten[0] ?? null;
			const minFavoriet = minstFavoriet[0] ?? null;
			return (
				<li>
					<a href={`/personen/${slugify(name)}/`} class="person-row">
						<span class="person-row-who">
							{party && party !== NO_PARTY && (
								<span class="person-row-party">
									<PartyIcon party={party} />
									{displayPartyName(party)}
								</span>
							)}
							<span class="topic-name">{name}</span>
						</span>
						<span class="person-row-signalen">
							{favoriet ? (
								<TagSignaalBadge
									signaal={favoriet}
									soort="favoriet"
									accentColor={PERSPECTIEF_KLEUR.get(TAG_PERSPECTIEF.get(favoriet.sleutel) ?? "") ?? ONBEKENDE_KLEUR}
									title={signaalTitle(favoriet, "favoriet", personTotal, globalTagCount, globalTagTotal, tagBeschrijving)}
								/>
							) : (
								<span class="tag-signaal tag-signaal-leeg">geen uitgesproken favoriet</span>
							)}
							{minFavoriet && (
								<TagSignaalBadge
									signaal={minFavoriet}
									soort="minst-favoriet"
									title={signaalTitle(minFavoriet, "minst favoriet", personTotal, globalTagCount, globalTagTotal, tagBeschrijving)}
								/>
							)}
						</span>
						<span class="topic-count">{count} argumenten</span>
					</a>
				</li>
			);
		})}
	</ul>
</BaseLayout>
