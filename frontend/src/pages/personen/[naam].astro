---
import ActorTagUsage from "../../components/ActorTagUsage.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { displayPartyName, canonicalParty } from "../../lib/parties";
import { slugify } from "../../lib/slug";
import { NO_PARTY } from "../../lib/types";
import { PERSPECTIEVEN } from "../../lib/tagIcons.generated";
import { perspectiefKleurVar } from "../../lib/tagIcon";
import { berekenTagSignalen, signaalTitle, signaalDetail } from "../../lib/tagSignalen";
import { deriveVerbositeitStats, deriveVerbositeitMedians, median } from "../../lib/aggregate";
import { partyIconMonoSvgRaw } from "../../lib/partyIconMono";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

function allArguments() {
	return Object.values(topicModules).flatMap((mod: any) =>
		mod.default.arguments.map((argument: any) => ({
			...argument,
			topicSlug: mod.default.slug,
			topicName: mod.default.name,
		})),
	);
}

function allSprekerbeurten() {
	return Object.values(topicModules).flatMap((mod: any) => mod.default.sprekerbeurten ?? []);
}

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });
	const persons = new Set<string>();
	for (const mod of Object.values(modules) as any[]) {
		for (const argument of mod.default.arguments) persons.add(argument.actor.name);
	}
	return [...persons].map((name) => ({
		params: { naam: slugify(name) },
		props: { name },
	}));
}

const { naam } = Astro.params;
const allArgs = allArguments();
const name =
	Astro.props.name ??
	allArgs.find((a: any) => slugify(a.actor.name) === naam)?.actor.name;

const argumentList = allArgs.filter((a: any) => a.actor.name === name);
const party = argumentList.find((a: any) => a.actor.party)?.actor.party ?? null;
const canonicalPartyNaam = party ? canonicalParty(party) : null;

// Vloei-categorische kleur (issue #220) i.p.v. tag-styles.json's kleur: die
// lag te dicht op pro/contra (zie grafiek.md).
const PERSPECTIEF_KLEUR = new Map(PERSPECTIEVEN.map((p) => [p.naam, perspectiefKleurVar(p.naam)]));
const TAG_PERSPECTIEF = new Map<string, string>();
for (const perspectief of PERSPECTIEVEN) {
	for (const sleutel of Object.keys(perspectief.tags)) TAG_PERSPECTIEF.set(sleutel, perspectief.naam);
}
const ONBEKENDE_KLEUR = "var(--vl-overig)";

// Zelfde basis als de personenlijst (/persoon/): alleen LLM-toegekende tags,
// dit keer over alle argumenten (allArgs) als globale noemer i.p.v. een
// vooraf geaggregeerde kaart, want deze pagina heeft de data toch al in
// geheugen staan voor ActorTagUsage.
const personTagCount = new Map<string, number>();
let personTotal = 0;
const globalTagCount = new Map<string, number>();
let globalTagTotal = 0;
const tagBeschrijving = new Map<string, string>();

// Voor de mediaanlijn op de taghistogram (issue #202): per tag de mediaan
// over alle personen heen, inclusief personen die een tag nooit gebruikten
// (0) -- zonder die nullen zou de mediaan een vertekend beeld geven van "hoe
// vaak gebruikt een willekeurige spreker deze tag doorgaans".
const allPersonNames = new Set<string>();
const tagCountPerPerson = new Map<string, Map<string, number>>();
const argCountPerPerson = new Map<string, number>();
const partyOfPerson = new Map<string, string>();

for (const argument of allArgs) {
	allPersonNames.add(argument.actor.name);
	if (argument.actor.party && !partyOfPerson.has(argument.actor.name)) {
		partyOfPerson.set(argument.actor.name, canonicalParty(argument.actor.party));
	}
	// Alleen argumenten met minstens één LLM-tag tellen mee als noemer -- bijna
	// de helft van alle argumenten heeft er geen (bv. te kort, of buiten de
	// taxonomie), en die als nul meetellen zou elk percentage verdunnen.
	if (argument.tags.some((t: any) => t.created_by === "llm")) {
		argCountPerPerson.set(argument.actor.name, (argCountPerPerson.get(argument.actor.name) ?? 0) + 1);
	}
	for (const tag of argument.tags) {
		if (tag.created_by !== "llm") continue;
		if (!tagBeschrijving.has(tag.sleutel)) tagBeschrijving.set(tag.sleutel, tag.beschrijving);
		globalTagCount.set(tag.sleutel, (globalTagCount.get(tag.sleutel) ?? 0) + 1);
		globalTagTotal++;
		if (argument.actor.name === name) {
			personTagCount.set(tag.sleutel, (personTagCount.get(tag.sleutel) ?? 0) + 1);
			personTotal++;
		}
		const perPerson = tagCountPerPerson.get(argument.actor.name) ?? new Map<string, number>();
		perPerson.set(tag.sleutel, (perPerson.get(tag.sleutel) ?? 0) + 1);
		tagCountPerPerson.set(argument.actor.name, perPerson);
	}
}

// Tags per argument (niet per tag-toekenning) als basis voor de mediaan: een
// kale telling, of zelfs een aandeel van iemands eigen tag-portfolio, laat
// zich lastig interpreteren zodra personen enorm verschillen in hoeveel ze
// aan het woord komen. "9 van de 490 argumenten kregen deze tag" (16%) is
// direct vergelijkbaar tussen sprekers, ook tussen een minister met 944
// toekenningen en een achterbanker met een handvol. Dezelfde schaal als de
// balk zelf (client-side ook per argument gedeeld, zie ActorTagUsage.vue),
// dus geen terugschaling meer nodig.
function tagMedianOver(personen: string[]): Record<string, number> {
	const result: Record<string, number> = {};
	for (const sleutel of globalTagCount.keys()) {
		const rates = personen.map((p) => {
			const totalArgs = argCountPerPerson.get(p) ?? 0;
			return totalArgs ? (tagCountPerPerson.get(p)?.get(sleutel) ?? 0) / totalArgs : 0;
		});
		result[sleutel] = median(rates);
	}
	return result;
}

const tagMedian = tagMedianOver([...allPersonNames]);

// Partijgenoten-mediaan (naast de mediaan over alle sprekers): laat zien of
// deze spreker ook binnen de eigen fractie op- of onderscheidt, niet alleen
// t.o.v. de volledige Kamer.
const tagPartyMedian =
	canonicalPartyNaam && canonicalPartyNaam !== NO_PARTY
		? tagMedianOver([...allPersonNames].filter((p) => partyOfPerson.get(p) === canonicalPartyNaam))
		: undefined;
const partyIconSvgRaw = canonicalPartyNaam && canonicalPartyNaam !== NO_PARTY ? partyIconMonoSvgRaw(canonicalPartyNaam) : null;

const { favorieten, minstFavoriet } = berekenTagSignalen(personTagCount, personTotal, globalTagCount, globalTagTotal, { topN: 3 });

// ActorTagUsage.vue rendert dit tussen de filterbalk en de taghistogram --
// de zware aggregatie (over het volledige corpus, niet alleen deze persoon)
// gebeurt hier server-side, de Vue-kant toont alleen de kant-en-klare rijen.
const favorieteTags = favorieten.map((signaal) => ({
	...signaal,
	beschrijving: tagBeschrijving.get(signaal.sleutel),
	accentColor: PERSPECTIEF_KLEUR.get(TAG_PERSPECTIEF.get(signaal.sleutel) ?? "") ?? ONBEKENDE_KLEUR,
	title: signaalTitle(signaal, "favoriet", personTotal, globalTagCount, globalTagTotal, tagBeschrijving),
	detail: signaalDetail(signaal, personTotal, globalTagCount, globalTagTotal),
}));
const minstFavorieteTags = minstFavoriet.map((signaal) => ({
	...signaal,
	beschrijving: tagBeschrijving.get(signaal.sleutel),
	title: signaalTitle(signaal, "minst favoriet", personTotal, globalTagCount, globalTagTotal, tagBeschrijving),
	detail: signaalDetail(signaal, personTotal, globalTagCount, globalTagTotal),
}));

// Tekststatistieken: statisch per persoon, reageert niet op FilterBar, dus
// platte Astro-markup i.p.v. een prop naar de client:only Vue-island -- zo
// belandt geen van deze cijfers (en zeker niet de onderliggende
// tekststatistieken) in de client-JS-bundle. Methodologie: zie
// /over/#tekststatistieken-methode.
const allSprekerbeurtenList = allSprekerbeurten();
const personSprekerbeurten = allSprekerbeurtenList.filter((s: any) => s.actor.name === name);
// Onder deze ondergrens zegt een gemiddelde te weinig -- zelfde soort
// afweging als PERSON_TAG_THRESHOLD in ActorTagUsage.vue.
const MIN_SPREKERBEURTEN = 3;
const verbositeitStats =
	personSprekerbeurten.length >= MIN_SPREKERBEURTEN ? deriveVerbositeitStats(personSprekerbeurten, argumentList) : null;
// Mediaan i.p.v. gemiddelde als corpus-ijkpunt: deze dichtheidsmaten zijn
// scheef verdeeld (een enkele spreker met veel argumenten per 1000 tekens
// trekt een gemiddelde omhoog), de mediaan is dan representatiever voor een
// "typische" spreker.
const corpusMedianen = verbositeitStats ? deriveVerbositeitMedians(allSprekerbeurtenList, allArgs, MIN_SPREKERBEURTEN) : null;

function badgeTitel(mediaan: number, decimalen: number): string {
	return `Mediaan over alle sprekers: ${mediaan.toFixed(decimalen)}`;
}

// Elke badge: een korte, neutrale categorie-omschrijving (waar meet dit iets
// over?), de technische term (voor wie de formule kent), het getal, en de
// mediaan over alle sprekers als ijkpunt -- plus een neutrale duiding van de
// richting (geen "goed/slecht", puur wat een hogere/lagere waarde betekent).
const verbositeitBadges =
	verbositeitStats && corpusMedianen
		? [
				{
					categorie: "Zinsbouw",
					term: "Gem. zinslengte",
					waarde: verbositeitStats.gemZinslengte,
					mediaan: corpusMedianen.gemZinslengte,
					decimalen: 1,
					eenheid: "woorden",
					richting: "hoger = langere zinnen",
				},
				{
					categorie: "Zinsbouw",
					term: "Flesch-Douma",
					waarde: verbositeitStats.fleschDouma,
					mediaan: corpusMedianen.fleschDouma,
					decimalen: 1,
					richting: "hoger = leesbaarder",
				},
				{
					categorie: "Zinsbouw",
					term: "LIX",
					waarde: verbositeitStats.lix,
					mediaan: corpusMedianen.lix,
					decimalen: 1,
					richting: "hoger = complexer",
				},
				{
					categorie: "Woordenschat",
					term: "MSTTR",
					waarde: verbositeitStats.msttr,
					mediaan: corpusMedianen.msttr,
					decimalen: 2,
					richting: "hoger = meer woordvariatie",
				},
				{
					categorie: "Argumentdichtheid",
					term: "Argumenten per 1000 tekens",
					waarde: verbositeitStats.argumentenPer1000Tekens,
					mediaan: corpusMedianen.argumentenPer1000Tekens,
					decimalen: 2,
					richting: "hoger = dichter beargumenteerd",
				},
				{
					categorie: "Onderbouwing",
					term: "Claims per argument",
					waarde: verbositeitStats.claimsPerArgument,
					mediaan: corpusMedianen.claimsPerArgument,
					decimalen: 2,
					richting: "hoger = vaker met een claim onderbouwd",
				},
			]
		: [];
---

<BaseLayout title={`${name || "Persoon"} - Bipolariteit`}>
	{canonicalPartyNaam && canonicalPartyNaam !== NO_PARTY ? (
		<a href={`/partijen/${slugify(canonicalPartyNaam)}/`} class="back-link">&larr; {displayPartyName(canonicalPartyNaam)}</a>
	) : (
		<a href="/personen/" class="back-link">&larr; alle personen</a>
	)}
	{name && (
		<ActorTagUsage
			name={name}
			mode="persoon"
			argumentList={argumentList}
			favorieteTags={favorieteTags}
			minstFavorieteTags={minstFavorieteTags}
			tagMedian={tagMedian}
			tagPartyMedian={tagPartyMedian}
			partyIconSvgRaw={partyIconSvgRaw}
			client:only="vue"
		>
			{verbositeitStats && corpusMedianen && (
				<section class="stats-panel verbositeit-stats" aria-label="Tekststatistieken" slot="voor-argumentlijst">
					<h2>
						Tekststatistieken
						<a href="/over/#tekststatistieken-methode" class="info-link" title="Hoe deze cijfers berekend worden" aria-label="Uitleg: hoe tekststatistieken berekend worden">?</a>
					</h2>
					<p class="panel-note">Op basis van {verbositeitStats.nSprekerbeurten} sprekerbeurten.</p>
					<dl class="verbositeit-grid">
						{verbositeitBadges.map((badge) => (
							<div class="verbositeit-badge" title={badgeTitel(badge.mediaan, badge.decimalen)}>
								<dt class="verbositeit-categorie">{badge.categorie}</dt>
								<dt class="verbositeit-term">{badge.term}</dt>
								<dd class="verbositeit-waarde">
									{badge.waarde.toFixed(badge.decimalen)}
									{badge.eenheid && <span class="verbositeit-eenheid">{badge.eenheid}</span>}
								</dd>
								<dd class="verbositeit-mediaan">mediaan {badge.mediaan.toFixed(badge.decimalen)}</dd>
								<dd class="verbositeit-richting">{badge.richting}</dd>
							</div>
						))}
					</dl>
				</section>
			)}
		</ActorTagUsage>
	)}
</BaseLayout>

<style>
	/* .verbositeit-stats zit boven op .stats-panel (main.css), dus overneemt
	   marge/padding/rand/achtergrond van daar -- alleen de dingen die
	   specifiek zijn voor dit blok staan hier. */
	.verbositeit-stats h2 {
		display: flex;
		align-items: center;
	}

	.verbositeit-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: var(--space-2);
		margin: 0;
	}

	/* Zelfde vaste-hoogte-aanpak als .card-tile (main.css) -- zonder
	   min-height/box-sizing lopen de tegels qua hoogte uiteen zodra "richting"
	   of een lange term (bv. "Argumenten per 1000 tekens") naar een tweede
	   regel omslaat, terwijl ze door de grid-rij toch al gelijk gerekt worden. */
	.verbositeit-badge {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 8.5rem;
		box-sizing: border-box;
		gap: 0.25rem;
		padding: var(--space-2);
		border: 1px solid var(--lijn);
		background: var(--vloei);
	}

	/* Twee lettertypes in dit hele blok: --font-tekst voor alle tekst,
	   --font-kop uitsluitend voor de twee getallen (waarde/mediaan) --
	   verder alleen gewicht/kleur/grootte als onderscheid, geen extra
	   font-family's of cursief erbij. */
	.verbositeit-categorie,
	.verbositeit-richting {
		font-size: 0.7rem;
		color: var(--galnoot-zacht);
	}

	.verbositeit-categorie {
		letter-spacing: 0.04em;
	}

	.verbositeit-term {
		font-weight: 600;
		font-size: var(--step--1);
		line-height: 1.25;
	}

	.verbositeit-badge dd {
		margin: 0;
	}

	.verbositeit-waarde {
		font-family: var(--font-kop);
		font-size: var(--step-0);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.verbositeit-eenheid {
		margin-left: 0.3em;
		font-size: var(--step--1);
		color: var(--galnoot-zacht);
	}

	.verbositeit-mediaan {
		margin-top: auto;
		font-family: var(--font-kop);
		font-size: var(--step--1);
		color: var(--galnoot-zacht);
		font-variant-numeric: tabular-nums;
	}

	.verbositeit-richting {
		line-height: 1.3;
	}
</style>
