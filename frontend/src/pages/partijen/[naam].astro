---
import ActorTagUsage from "../../components/ActorTagUsage.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { NO_PARTY } from "../../lib/types";
import { slugify } from "../../lib/slug";
import { canonicalParty } from "../../lib/parties";
import { boxplotStats, type BoxplotStats } from "../../lib/aggregate";

const topicModules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });

function allArguments() {
	return Object.values(topicModules).flatMap((mod: any) =>
		mod.default.arguments.map((argument: any) => ({
			...argument,
			topicSlug: mod.default.slug,
			topicName: mod.default.name,
		})),
	);
}

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../data/export/topics/*.json", { eager: true });
	const parties = new Set<string>();
	for (const mod of Object.values(modules) as any[]) {
		for (const argument of mod.default.arguments) {
			if (argument.actor.party && argument.actor.party !== NO_PARTY) parties.add(canonicalParty(argument.actor.party));
		}
	}
	return [...parties].map((party) => ({
		params: { naam: slugify(party) },
		props: { party },
	}));
}

const { naam } = Astro.params;
const allArgs = allArguments();
const matchedArg = allArgs.find((a: any) => a.actor.party && slugify(canonicalParty(a.actor.party)) === naam);
const party = Astro.props.party ?? (matchedArg && canonicalParty(matchedArg.actor.party));

const argumentList = allArgs.filter((a: any) => a.actor.party && canonicalParty(a.actor.party) === party);

// Zelfde boxplot-whisker als op de persoonspagina (issue #202-vervolg), hier
// over alle partijen i.p.v. alle personen -- inclusief partijen die een tag
// nooit gebruikten (0).
const allParties = new Set<string>();
const tagCountPerParty = new Map<string, Map<string, number>>();
const tagTotalPerParty = new Map<string, number>();
const globalTagCount = new Map<string, number>();

for (const argument of allArgs) {
	if (!argument.actor.party || argument.actor.party === NO_PARTY) continue;
	const argPartij = canonicalParty(argument.actor.party);
	allParties.add(argPartij);
	for (const tag of argument.tags) {
		if (tag.created_by !== "llm") continue;
		globalTagCount.set(tag.sleutel, (globalTagCount.get(tag.sleutel) ?? 0) + 1);
		const perParty = tagCountPerParty.get(argPartij) ?? new Map<string, number>();
		perParty.set(tag.sleutel, (perParty.get(tag.sleutel) ?? 0) + 1);
		tagCountPerParty.set(argPartij, perParty);
		tagTotalPerParty.set(argPartij, (tagTotalPerParty.get(argPartij) ?? 0) + 1);
	}
}

// Aandeel i.p.v. kale telling: partijen verschillen enorm in totaalvolume
// (VVD ~1845 vs. DENK ~98 argumenten), dus de verdeling van kale tellingen
// over alle partijen zou gedomineerd worden door de grootste partijen --
// zichtbaar als een whisker die bij een kleine partij vrijwel elke balk
// overschrijdt, ook als die partij een tag juist relatief vaak gebruikt.
// Terugschalen naar déze partij se eigen totaal houdt de whisker op dezelfde
// as als de balk (aantallen).
const partyTotal = tagTotalPerParty.get(party ?? "") ?? 0;
const tagBoxplot: Record<string, BoxplotStats> = {};
for (const sleutel of globalTagCount.keys()) {
	const aandelen = [...allParties].map((p) => {
		const total = tagTotalPerParty.get(p) ?? 0;
		return total ? (tagCountPerParty.get(p)?.get(sleutel) ?? 0) / total : 0;
	});
	const stats = boxplotStats(aandelen);
	tagBoxplot[sleutel] = { median: stats.median * partyTotal, q1: stats.q1 * partyTotal, q3: stats.q3 * partyTotal };
}
---

<BaseLayout title={`${party || "Partij"} - Bipolariteit`}>
	<a href="/onderwerpen/" class="back-link">&larr; alle onderwerpen</a>
	{party && <ActorTagUsage name={party} mode="partij" argumentList={argumentList} tagBoxplot={tagBoxplot} client:only="vue" />}
</BaseLayout>
