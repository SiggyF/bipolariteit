			<ellipse cx="35" cy="30" rx="30" ry="13" transform="rotate(-15 35 30)" fill="none" stroke="currentColor" stroke-width="2.5" />
			<ellipse cx="65" cy="30" rx="30" ry="13" transform="rotate(15 65 30)" fill="none" stroke="currentColor" stroke-width="2.5" />
