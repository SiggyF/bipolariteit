---
// Deelknop in SiteNav.astro (issue #172, ontwerp van de vormgever in
// data/export/design-handoff/deelknoppen-preview/, niet ingecheckt). Eén
// knop naast de theme-toggle, gaat dus elke pagina mee. Client-side, want
// de deelinhoud (titel/URL van de huidige pagina) is pas in de browser
// bekend -- geen per-paginatype server-side sjabloonzin (vraag C in het
// ontwerppakket), dat vraagt datavelden (bv. argumentaantallen) die niet
// overal server-side beschikbaar zijn (zie onderwerp-pagina's, die de
// argumentenlijst client-side fetchen, issue #163). document.title volstaat
// als titel: die is al per pagina uniek gezet via BaseLayout.

const PLATFORMS: Array<{ key: string; label: string; icon: string }> = [
	{
		key: "x",
		label: "X",
		icon: `<path d="M4 4l16 16M20 4L4 20"/>`,
	},
	{
		key: "linkedin",
		label: "LinkedIn",
		icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10.5v6M7.5 7.6v.1M11.5 16.5v-6M11.5 13c0-1.4 1-2.5 2.4-2.5s2.6 1 2.6 2.6v3.4"/>`,
	},
	{
		key: "bluesky",
		label: "Bluesky",
		icon: `<path d="M3 5c0 6 4.5 10 9 14 4.5-4 9-8 9-14 0-2-1.6-3-3-2.2C16.5 3.9 13.5 7 12 10 10.5 7 7.5 3.9 6 2.8 4.6 2 3 3 3 5z"/>`,
	},
	{
		key: "whatsapp",
		label: "WhatsApp",
		icon: `<path d="M21 11.5a8.4 8.4 0 01-12.5 7.3L3 20.5l1.8-5.3A8.4 8.4 0 1121 11.5z"/><path d="M8.8 9c.3 2.6 3.6 5.9 6.2 6.2l1.2-1.5 2 1c-.4 1.3-1.7 1.9-3 1.6-3-.7-6-3.7-6.7-6.7-.3-1.3.3-2.6 1.6-3l1 2z"/>`,
	},
	{
		key: "facebook",
		label: "Facebook",
		icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M14.5 8h-1.2c-.9 0-1.3.5-1.3 1.4V21M9.8 12.5h4.6"/>`,
	},
	{
		key: "email",
		label: "E-mail",
		icon: `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>`,
	},
];
---

<div class="share-menu" id="share-menu">
	<button
		type="button"
		class="share-menu-trigger"
		id="share-menu-trigger"
		aria-haspopup="menu"
		aria-expanded="false"
		aria-controls="share-menu-list"
	>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
			<line x1="8.6" y1="10.5" x2="15.4" y2="6.5"></line><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line>
		</svg>
		<span>Delen</span>
	</button>
	<div class="share-menu-panel" id="share-menu-list" role="menu" hidden>
		<div class="share-menu-label">Deel deze pagina</div>
		<div class="share-menu-grid">
			{PLATFORMS.map((platform) => (
				<a href="#" class="share-menu-item" role="menuitem" data-platform={platform.key}>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={platform.icon} />
					<span>{platform.label}</span>
				</a>
			))}
		</div>
		<div class="share-menu-divider"></div>
		<button type="button" class="share-menu-item share-menu-copy" role="menuitem" id="share-menu-copy">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M10 13.5a4 4 0 006 .5l2.5-2.5a4 4 0 00-5.7-5.7L11.5 7"/><path d="M14 10.5a4 4 0 00-6-.5L5.5 12.5a4 4 0 005.7 5.7L12.5 17"/>
			</svg>
			<span data-copy-label>Link kopiëren</span>
		</button>
	</div>
</div>

<script is:inline>
	(function () {
		document.addEventListener("DOMContentLoaded", function () {
			var root = document.getElementById("share-menu");
			if (!root) return;
			var trigger = document.getElementById("share-menu-trigger");
			var panel = document.getElementById("share-menu-list");

			function shareData() {
				return { title: document.title, url: location.href };
			}

			function openPanel() {
				panel.hidden = false;
				trigger.setAttribute("aria-expanded", "true");
				document.addEventListener("keydown", onKeydown);
				document.addEventListener("click", onClickOutside);
			}

			function closePanel() {
				panel.hidden = true;
				trigger.setAttribute("aria-expanded", "false");
				document.removeEventListener("keydown", onKeydown);
				document.removeEventListener("click", onClickOutside);
			}

			function onKeydown(event) {
				if (event.key === "Escape") {
					closePanel();
					trigger.focus();
				}
			}

			function onClickOutside(event) {
				if (!root.contains(event.target)) closePanel();
			}

			// navigator.share bestaat ook op desktop Safari/Chrome (macOS) --
			// puur op de aanwezigheid van de API afgaan zou daar het systeemmenu
			// tonen waar het ontwerp de dropdown wil (zie "Desktop -- gesloten en
			// open" vs. "Mobiel -- Web Share API" in het ontwerppakket). Een grof
			// (touch-)pointer als proxy voor "mobiel" onderscheidt dat betrouwbaar.
			var isTouchPrimary = window.matchMedia && window.matchMedia("(pointer: coarse)").matches;

			trigger.addEventListener("click", function () {
				if (navigator.share && isTouchPrimary) {
					navigator.share(shareData()).catch(function () {
						/* gebruiker annuleerde het systeemdeelvenster, geen actie nodig */
					});
					return;
				}
				if (panel.hidden) openPanel();
				else closePanel();
			});

			var shareUrls = {
				x: function (d) {
					return "https://twitter.com/intent/tweet?text=" + encodeURIComponent(d.title) + "&url=" + encodeURIComponent(d.url);
				},
				linkedin: function (d) {
					return "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(d.url);
				},
				bluesky: function (d) {
					return "https://bsky.app/intent/compose?text=" + encodeURIComponent(d.title + " " + d.url);
				},
				whatsapp: function (d) {
					return "https://wa.me/?text=" + encodeURIComponent(d.title + " " + d.url);
				},
				facebook: function (d) {
					return "https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent(d.url);
				},
				email: function (d) {
					return "mailto:?subject=" + encodeURIComponent(d.title) + "&body=" + encodeURIComponent(d.url);
				},
			};

			panel.querySelectorAll("[data-platform]").forEach(function (link) {
				link.addEventListener("click", function (event) {
					event.preventDefault();
					var platform = link.getAttribute("data-platform");
					var build = shareUrls[platform];
					if (!build) return;
					window.open(build(shareData()), "_blank", "noopener,noreferrer,width=600,height=500");
					closePanel();
				});
			});

			var copyButton = document.getElementById("share-menu-copy");
			var copyLabel = copyButton.querySelector("[data-copy-label]");
			copyButton.addEventListener("click", function () {
				navigator.clipboard.writeText(location.href).then(function () {
					copyLabel.textContent = "Gekopieerd";
					copyButton.classList.add("is-copied");
					setTimeout(function () {
						copyLabel.textContent = "Link kopiëren";
						copyButton.classList.remove("is-copied");
						closePanel();
					}, 2000);
				});
			});
		});
	})();
</script>
