# let op: `data/raw/*` i.p.v. `data/raw/` -- met een dichte directory-regel
# kan git een negation-regel op een bestand daaronder niet meer toepassen
# (git doorzoekt een uitgesloten directory dan niet meer), zie de
# uitzondering hieronder voor elecdebate60to16/Makefile.
data/raw/*
# Uitzondering: het fetch-Makefile voor ELECDEBATE60TO16 (issue #62) is wel
# ingecheckt, de rest van data/raw/elecdebate60to16/ (dataset, paper, derived
# JSONL) niet -- zie dat Makefile.
!data/raw/elecdebate60to16/
data/raw/elecdebate60to16/*
!data/raw/elecdebate60to16/Makefile
# Experimentele tussendocumenten, geen frontend-input (i.t.t. data/export/topics/):
# lokale verificatie/input voor handmatig LLM-werk, bewust niet gecommit.
data/export/argument-trees/
data/export/argument-docs/
data/export/design-handoff/
data/export/agy_confrontatie_tree.log
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.db.bak-*
node_modules/
frontend/dist/
# Per release gerenderd uit deploy/wrangler.template.jsonc.
wrangler.generated.jsonc
frontend/.astro/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
# gemini_config leeft nu buiten de repo (~/.bipolariteit/agy_gemini_config,
# zie docs/handoff.md) -- deze regel blijft als vangnet mocht die directory
# ooit per ongeluk weer lokaal onder de repo aangemaakt worden.
docker/agy/gemini_config/

# Illustrator-krasbestanden; het echte logos.ai wordt wel ingecheckt.
~ai-*.tmp

# Local git settings
.env.local
.devcontainer/.env.local
.devcontainer/gpg-pubkey.asc
