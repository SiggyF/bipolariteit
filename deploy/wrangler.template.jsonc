// Sjabloon voor de wrangler-configuratie van één preview-release.
//
// scripts/release_preview.py vult de twee placeholders hieronder in en schrijft
// het resultaat naar wrangler.generated.jsonc in de repo-root (ongetrackt). Dat
// gebeurt per release, want zowel de Worker-naam als de hostnaam bevatten de
// tag. Noem de placeholders niet in commentaar: ze worden overal vervangen.
{
	"name": "__NAAM__",
	"main": "deploy/worker.js",
	"compatibility_date": "2026-07-30",
	"assets": {
		"directory": "frontend/dist",
		"binding": "ASSETS",
		// Zonder dit draait deploy/worker.js alleen bij een 404: standaard
		// serveert Cloudflare een bestaand bestand rechtstreeks en slaat de
		// Worker over. De noindex-header ontbrak daardoor stilzwijgend op
		// precies de pagina's waar hij nodig is.
		"run_worker_first": true,
		// Serveert dist/404.html (uit frontend/src/pages/404.astro) bij een
		// onbekende URL. Bewust gekozen boven "single-page-application", want
		// dit is een multi-page site: bij die laatste instelling zou een
		// typfout in de URL de homepage met status 200 teruggeven, en dat
		// maakt kapotte links onzichtbaar.
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			// custom_domain laat Cloudflare zelf het DNS-record aanmaken en het
			// certificaat regelen. Eén niveau onder het domein, dus gedekt door
			// het gratis Universal SSL-certificaat (*.bipolariteit.org).
			"pattern": "__HOSTNAAM__",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
