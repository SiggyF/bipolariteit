# Pipeline-workflow voor de About-pagina ("hoe werkt het").
# Vertical layout (direction: down): elke stap in de tijd van bron tot site.
# Render: d2 docs/diagrams/pipeline_workflow.d2 frontend/public/pipeline-workflow.svg

direction: down

vars: {
  d2-config: {
    theme-id: 0
  }
}

bron: "Bron: Tweede Kamer\n(opendata.tweedekamer.nl)" {
  shape: cylinder
  style.fill: "#eef2ff"
}

crawl: "1. Crawlen\ncrawlers/tweede_kamer (Scrapy)" {
  style.fill: "#e0e7ff"
  detail: "Haalt Verslag-XML op via de OData-API.\nGeen LLM, mag altijd draaien (ook op accu)."
}

ingest: "2. Segmenteren\npipeline/ingest/ingest_tk.py" {
  style.fill: "#e0e7ff"
  detail: "Eén Verslag (heel debat) -> N documents,\néén rij per sprekerbeurt (woordvoerder/interrumpant)."
}

db_documents: "documents\n(SQLite, lokaal, nooit gecommit)" {
  shape: cylinder
  style.fill: "#f1f5f9"
}

extract: "3. Stage 1 -- Argumenten extraheren\npipeline/extract_arguments.py" {
  style.fill: "#dbeafe"
  detail: "Lokaal LLM (qwen3.6-27b via LM Studio).\nPer sprekerbeurt: 0..n argumenten\n(stance, typologie, citaat, claims).\nAlleen op netstroom (meerdere uren)."
}

tag: "3b. Tags toekennen\npipeline/tag_arguments.py" {
  style.fill: "#dbeafe"
  detail: "Taxonomie uit data/tags.toml.\n3 labelgroepen deterministisch afgeleid,\nde rest via hetzelfde lokale LLM."
}

redactie: "4. Stage 2 -- Redactie-check\npipeline/redactie_check.py" {
  style.fill: "#dbeafe"
  detail: "Bias-balans-snapshot per document +\nopposition-linking (tegenargument-koppeling).\nGeen feitelijke-juistheids-check."
}

db_arguments: "arguments / claims / tags /\nargument_oppositions / redactie_reviews" {
  shape: cylinder
  style.fill: "#f1f5f9"
}

validatie: "Steekproefcontrole (menselijk + Gemini)\nscripts/build_extraction_review_doc.py" {
  style.fill: "#fef3c7"
  detail: "Representatieve steekproef per onderwerp,\nvóór elke launch/her-extractie."
}

rapport: "validatie_rapportage.md\n(gecommit, publiek)" {
  shape: document
  style.fill: "#fef3c7"
}

export: "5. Export\npipeline/build_static_data.py" {
  style.fill: "#dcfce7"
  detail: "SQLite -> data/export/topics/<slug>.json\n+ topics-index.json (gecommit)."
}

frontend: "6. Frontend build\nAstro + Vue (frontend/)" {
  style.fill: "#dcfce7"
  detail: "Statische build op de gecommitte JSON.\nGeen server, geen secrets nodig."
}

live: "bipolariteit.org\n(Cloudflare Pages, gratis tier)" {
  shape: cloud
  style.fill: "#bbf7d0"
}

about: "About-pagina: methodologie\n(model, promptversie, validatierapport)" {
  shape: document
  style.fill: "#fde68a"
}

bron -> crawl
crawl -> ingest
ingest -> db_documents
db_documents -> extract
extract -> tag
tag -> redactie
redactie -> db_arguments: "schrijft"
extract -> db_arguments: "schrijft" {
  style.stroke-dash: 3
}

db_arguments -> validatie: "steekproef"
validatie -> rapport: "resultaten"

db_arguments -> export
export -> frontend
frontend -> live: "build + deploy"

rapport -> about: "gelinkt vanaf"
extract -> about: "prompt-hash + model" {
  style.stroke-dash: 3
}
tag -> about: "prompt-hash + model" {
  style.stroke-dash: 3
}
redactie -> about: "prompt-hash + model" {
  style.stroke-dash: 3
}
about -> live: "onderdeel van"
